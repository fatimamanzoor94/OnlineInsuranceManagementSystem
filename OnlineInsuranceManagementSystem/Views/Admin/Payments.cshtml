@model List<OnlineInsuranceManagementSystem.ViewModels.PaymentViewModel>
@{
    ViewData["Title"] = "Payments Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Populate dropdowns from ViewBag
    var customers = ViewBag.Customers as List<OnlineInsuranceManagementSystem.Models.User> ?? new();
    var policies = ViewBag.Policies as List<OnlineInsuranceManagementSystem.Models.Policy> ?? new();
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Payments Management</h4>
                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 rounded-pill px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#addPaymentModal">
                    <i class="bx bx-plus"></i> Add Payment
                </button>
            </div>

            <!-- TOP SUMMARY CARDS (Same design as Claims page) -->
            <div class="row g-3 mb-4">
                <!-- Total Payments -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-credit-card text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Payments</h6>
                                <small class="text-muted" id="totalPayments">@ViewBag.TotalPayments</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <!-- Paid Payments -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Paid Payments</h6>
                                <small class="text-muted" id="paidPayments">@ViewBag.PaidPayments</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <!-- Pending Payments -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hourglass-split text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Payments</h6>
                                <small class="text-muted" id="pendingPayments">@ViewBag.PendingPayments</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <!-- Failed Payments -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-x-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Failed Payments</h6>
                                <small class="text-muted" id="failedPayments">@ViewBag.FailedPayments</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter (Same design as Claims page) -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Payment ID</label>
                            <input type="text" id="searchPaymentId"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter payment ID..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Customer/Policy</label>
                            <input type="text" id="searchName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter customer, policy or transaction ID..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Filter Status</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill active" data-filter="all">All</button>
                                <button class="btn btn-sm btn-outline-success rounded-pill" data-filter="paid">Paid</button>
                                <button class="btn btn-sm btn-outline-warning rounded-pill" data-filter="pending">Pending</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill" data-filter="failed">Failed</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table (Same design as Claims page) -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">All Payments</h4>
                            <small class="text-muted">Manage policy payments submitted by users</small>
                        </div>
                        <!-- Export Buttons (Same function as Claims page) -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'paymentsTable', 'Payments')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'paymentsTable', 'Payments')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="paymentsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Payment ID</th>
                                    <th>Customer Name</th>
                                    <th>Policy Name</th>
                                    <th>Amount</th>
                                    <th>Payment Method</th>
                                    <th>Transaction ID</th>
                                    <th>Payment Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model)
                                {
                                    <tr data-status="@payment.Status.ToLower()">
                                        <td>@payment.PaymentIdDisplay</td>
                                        <td>@payment.UserName</td>
                                        <td>@payment.PolicyName</td>
                                        <td class="fw-semibold text-primary">@payment.AmountDisplay</td>
                                        <td>@(string.IsNullOrEmpty(payment.PaymentMethod) ? "-" : payment.PaymentMethod)</td>
                                        <td class="text-muted small">@(string.IsNullOrEmpty(payment.TransactionId) ? "-" : payment.TransactionId)</td>
                                        <td>@payment.PaymentDateDisplay</td>
                                        <td>
                                            <span class="badge @payment.StatusBadgeClass">@payment.StatusText</span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm d-flex gap-2">
                                                <!-- VIEW BUTTON -->
                                                <button class="btn btn-outline-info view-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#viewPaymentModal"
                                                        data-paymentid="@payment.PaymentId"
                                                        data-username="@payment.UserName"
                                                        data-policyname="@payment.PolicyName"
                                                        data-amount="@payment.Amount.ToString("F2")"
                                                        data-paymentmethod="@(payment.PaymentMethod ?? "-")"
                                                        data-transactionid="@(payment.TransactionId ?? "-")"
                                                        data-paymentdate="@payment.PaymentDateDisplay"
                                                        data-status="@payment.Status"
                                                        title="View Details">
                                                    View
                                                </button>

                                                <!-- EDIT BUTTON -->
                                                <button class="btn btn-outline-warning edit-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editPaymentModal"
                                                        data-paymentid="@payment.PaymentId"
                                                        data-userid="@payment.UserId"
                                                        data-policyid="@payment.PolicyId"
                                                        data-amount="@payment.Amount.ToString("F2")"
                                                        data-paymentdate="@payment.PaymentDate.ToString("yyyy-MM-dd")"
                                                        data-paymentmethod="@(payment.PaymentMethod ?? "")"
                                                        data-transactionid="@(payment.TransactionId ?? "")"
                                                        data-status="@payment.Status"
                                                        title="Edit">
                                                    Edit
                                                </button>

                                                <!-- DELETE BUTTON -->
                                                <button type="button"
                                                        class="btn btn-outline-danger delete-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deletePaymentModal"
                                                        data-paymentid="@payment.PaymentId"
                                                        data-paymentinfo="@payment.UserName - @payment.PolicyName"
                                                        title="Delete">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination (Same as Claims page) -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Payments: @Model.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ADD PAYMENT MODAL ==================== -->
<div class="modal fade" id="addPaymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Add New Payment</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="CreatePayment" method="post">
                    <!-- User Dropdown -->
                    <select name="UserId" class="form-select mb-2 rounded-pill" required>
                        <option value="">Select Customer</option>
                        @foreach (var customer in customers.Where(c => c.Role == "Customer"))
                        {
                            <option value="@customer.UserId">@customer.FullName</option>
                        }
                    </select>

                    <!-- Policy Dropdown -->
                    <select name="PolicyId" class="form-select mb-2 rounded-pill" required>
                        <option value="">Select Policy</option>
                        @foreach (var policy in policies)
                        {
                            <option value="@policy.PolicyId">@policy.PolicyName</option>
                        }
                    </select>

                    <!-- Amount -->
                    <input type="number" name="Amount" class="form-control mb-2 rounded-pill"
                           placeholder="Enter payment amount" step="0.01" min="0" required />

                    <!-- Payment Date -->
                    <input type="date" name="PaymentDate" class="form-control mb-2 rounded-pill"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" required />

                    <!-- Payment Method -->
                    <select name="PaymentMethod" class="form-select mb-2 rounded-pill">
                        <option value="">Select Payment Method</option>
                        <option value="Credit Card">Credit Card</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="PayPal">PayPal</option>
                        <option value="Cash">Cash</option>
                    </select>

                    <!-- Transaction ID -->
                    <input type="text" name="TransactionId" class="form-control mb-2 rounded-pill"
                           placeholder="Enter transaction ID (optional)" />

                    <!-- Status Dropdown -->
                    <select name="Status" class="form-select mb-2 rounded-pill">
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                        <option value="Failed">Failed</option>
                    </select>

                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Save Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== EDIT PAYMENT MODAL ==================== -->
<div class="modal fade" id="editPaymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Edit Payment</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="UpdatePayment" method="post">
                    <input type="hidden" id="editPaymentId" name="PaymentId" />

                    <!-- User Dropdown -->
                    <select id="editUserId" name="UserId" class="form-select mb-2 rounded-pill" required>
                        <option value="">Select Customer</option>
                        @foreach (var customer in customers.Where(c => c.Role == "Customer"))
                        {
                            <option value="@customer.UserId">@customer.FullName</option>
                        }
                    </select>

                    <!-- Policy Dropdown -->
                    <select id="editPolicyId" name="PolicyId" class="form-select mb-2 rounded-pill" required>
                        <option value="">Select Policy</option>
                        @foreach (var policy in policies)
                        {
                            <option value="@policy.PolicyId">@policy.PolicyName</option>
                        }
                    </select>

                    <!-- Amount -->
                    <input type="number" id="editAmount" name="Amount" class="form-control mb-2 rounded-pill"
                           placeholder="Enter payment amount" step="0.01" min="0" required />

                    <!-- Payment Date -->
                    <input type="date" id="editPaymentDate" name="PaymentDate" class="form-control mb-2 rounded-pill" required />

                    <!-- Payment Method -->
                    <select id="editPaymentMethod" name="PaymentMethod" class="form-select mb-2 rounded-pill">
                        <option value="">Select Payment Method</option>
                        <option value="Credit Card">Credit Card</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="PayPal">PayPal</option>
                        <option value="Cash">Cash</option>
                    </select>

                    <!-- Transaction ID -->
                    <input type="text" id="editTransactionId" name="TransactionId" class="form-control mb-2 rounded-pill"
                           placeholder="Enter transaction ID (optional)" />

                    <!-- Status Dropdown -->
                    <select id="editStatus" name="Status" class="form-select mb-2 rounded-pill">
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                        <option value="Failed">Failed</option>
                    </select>

                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Update Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DELETE PAYMENT MODAL ==================== -->
<div class="modal fade" id="deletePaymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icon-box delete-icon">
                    <i class="fas fa-trash-alt"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Delete Payment?</h4>
                <p class="text-muted">
                    You are about to delete <strong id="deletePaymentInfo"></strong><br />
                    This action cannot be undone.
                </p>
                <form asp-action="DeletePayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deletePaymentId" name="id" />
                    <div class="d-flex gap-2 justify-content-center mt-3">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4 rounded-pill">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW PAYMENT DETAILS MODAL ==================== -->
<div class="modal fade" id="viewPaymentModal" tabindex="-1" aria-labelledby="viewPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-credit-card text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewPaymentModalLabel">Payment Details</h5>
                        <small class="text-muted" id="viewPaymentIdDisplay">#PAY-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Customer Name -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Customer Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewUserName">-</p>
                        </div>
                        <!-- Policy Name -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-shield me-1"></i>Policy Name</label>
                            <p class="form-control-plaintext mb-0" id="viewPolicyName">-</p>
                        </div>
                        <!-- Amount -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-dollar me-1"></i>Amount</label>
                            <p class="form-control-plaintext fw-semibold text-primary mb-0" id="viewAmount">-</p>
                        </div>
                        <!-- Payment Method -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-credit-card me-1"></i>Payment Method</label>
                            <p class="form-control-plaintext mb-0" id="viewPaymentMethod">-</p>
                        </div>
                        <!-- Transaction ID -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-hash me-1"></i>Transaction ID</label>
                            <p class="form-control-plaintext mb-0" id="viewTransactionId">-</p>
                        </div>
                        <!-- Payment Date & Status -->
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Payment Date</label>
                                <p class="form-control-plaintext mb-0" id="viewPaymentDate">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="viewEditPaymentBtn">
                    Edit Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Same as Claims page) ==================== -->
<style>
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        background: #ffffff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .delete-icon {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .delete-icon i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* View Modal Enhancements */
    #viewPaymentModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewPaymentModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    #viewPaymentModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        #viewPaymentModal .card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    @@media (max-width: 576px) {
        #viewPaymentModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewPaymentModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT (Same behavior as Claims page) ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==================== SEARCH FUNCTIONALITY ====================
            const searchPaymentId = document.getElementById('searchPaymentId');
            const searchName = document.getElementById('searchName');

            function filterTable() {
                const paymentIdVal = searchPaymentId.value.toLowerCase();
                const nameVal = searchName.value.toLowerCase();

                document.querySelectorAll("#paymentsTable tbody tr").forEach(row => {
                    const paymentId = row.cells[0]?.textContent.toLowerCase() || '';
                    const customerName = row.cells[1]?.textContent.toLowerCase() || '';
                    const policyName = row.cells[2]?.textContent.toLowerCase() || '';
                    const transactionId = row.cells[5]?.textContent.toLowerCase() || '';

                    const matches = (paymentId.includes(paymentIdVal)) &&
                                   (customerName.includes(nameVal) || policyName.includes(nameVal) || transactionId.includes(nameVal));

                    row.style.display = matches ? "" : "none";
                });
            }

            searchPaymentId.addEventListener("input", filterTable);
            searchName.addEventListener("input", filterTable);


            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const tableRows = document.querySelectorAll("#paymentsTable tbody tr");
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function displayTablePage(page) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                tableRows.forEach((row, index) => {
                    row.style.display = (index >= start && index < end) ? "" : "none";
                });
                updatePaginationButtons();
            }

            function updatePaginationButtons() {
                pagination.innerHTML = "";
                const pageCount = Math.ceil(tableRows.length / rowsPerPage);

                // Prev Button
                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prevLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage > 1) displayTablePage(currentPage - 1);
                });
                pagination.appendChild(prevLi);

                // Page Numbers
                for (let i = 1; i <= pageCount; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${currentPage === i ? "active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", function (e) {
                        e.preventDefault();
                        displayTablePage(i);
                    });
                    pagination.appendChild(li);
                }

                // Next Button
                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                nextLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage < pageCount) displayTablePage(currentPage + 1);
                });
                pagination.appendChild(nextLi);
            }

            displayTablePage(1);


            // ==================== STATUS FILTER ====================
            document.querySelectorAll("[data-filter]").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    const filter = this.getAttribute('data-filter');
                    const rows = document.querySelectorAll("#paymentsTable tbody tr");

                    rows.forEach(row => {
                        const rowStatus = row.getAttribute('data-status');

                        if (filter === 'all') {
                            row.style.display = '';
                        } else if (filter === rowStatus) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });


            // ==================== EDIT MODAL - Populate Data ====================
            const editModal = document.getElementById('editPaymentModal');
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                document.getElementById('editPaymentId').value = button.getAttribute('data-paymentid');
                document.getElementById('editUserId').value = button.getAttribute('data-userid');
                document.getElementById('editPolicyId').value = button.getAttribute('data-policyid');
                document.getElementById('editAmount').value = button.getAttribute('data-amount');
                document.getElementById('editPaymentDate').value = button.getAttribute('data-paymentdate');
                document.getElementById('editPaymentMethod').value = button.getAttribute('data-paymentmethod');
                document.getElementById('editTransactionId').value = button.getAttribute('data-transactionid');
                document.getElementById('editStatus').value = button.getAttribute('data-status');
            });


            // ==================== DELETE MODAL - Populate Data ====================
            const deleteModal = document.getElementById('deletePaymentModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('deletePaymentId').value = button.getAttribute('data-paymentid');
                document.getElementById('deletePaymentInfo').textContent = button.getAttribute('data-paymentinfo');
            });


            // ==================== VIEW MODAL - Populate Data ====================
            const viewModal = document.getElementById('viewPaymentModal');

            viewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                const paymentId = button.getAttribute('data-paymentid');
                const userName = button.getAttribute('data-username');
                const policyName = button.getAttribute('data-policyname');
                const amount = button.getAttribute('data-amount');
                const paymentMethod = button.getAttribute('data-paymentmethod');
                const transactionId = button.getAttribute('data-transactionid');
                const paymentDate = button.getAttribute('data-paymentdate');
                const status = button.getAttribute('data-status');

                // Populate fields
                document.getElementById('viewPaymentIdDisplay').textContent = `#PAY-${paymentId}`;
                document.getElementById('viewUserName').textContent = userName || '-';
                document.getElementById('viewPolicyName').textContent = policyName || '-';
                document.getElementById('viewAmount').textContent = `$${parseFloat(amount).toFixed(2)}`;
                document.getElementById('viewPaymentMethod').textContent = paymentMethod || '-';
                document.getElementById('viewTransactionId').textContent = transactionId || '-';
                document.getElementById('viewPaymentDate').textContent = paymentDate || '-';

                // Status Badge
                const statusBadge = document.getElementById('viewStatusBadge');
                const statusLower = status?.toLowerCase();

                if (statusLower === 'paid') {
                    statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                    statusBadge.textContent = 'Paid';
                } else if (statusLower === 'failed') {
                    statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                    statusBadge.textContent = 'Failed';
                } else {
                    statusBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
                    statusBadge.textContent = 'Pending';
                }

                // Edit button in view modal -> open edit modal
                document.getElementById('viewEditPaymentBtn').onclick = function() {
                    const modalInstance = bootstrap.Modal.getInstance(viewModal);
                    modalInstance.hide();

                    setTimeout(() => {
                        const fakeEditBtn = document.createElement('button');
                        fakeEditBtn.setAttribute('data-bs-toggle', 'modal');
                        fakeEditBtn.setAttribute('data-bs-target', '#editPaymentModal');
                        fakeEditBtn.setAttribute('data-paymentid', paymentId);
                        fakeEditBtn.setAttribute('data-userid', button.getAttribute('data-userid'));
                        fakeEditBtn.setAttribute('data-policyid', button.getAttribute('data-policyid'));
                        fakeEditBtn.setAttribute('data-amount', amount);
                        fakeEditBtn.setAttribute('data-paymentdate', paymentDate);
                        fakeEditBtn.setAttribute('data-paymentmethod', paymentMethod);
                        fakeEditBtn.setAttribute('data-transactionid', transactionId);
                        fakeEditBtn.setAttribute('data-status', status);
                        document.body.appendChild(fakeEditBtn);
                        fakeEditBtn.click();
                        fakeEditBtn.remove();
                    }, 150);
                };
            });

        });
    </script>
}