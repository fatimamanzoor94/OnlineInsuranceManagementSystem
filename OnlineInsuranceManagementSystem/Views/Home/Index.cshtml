<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("contactForm");

        form.addEventListener("submit", function (e) {

            let isValid = true;

            const inputs = form.querySelectorAll("input, textarea");

            inputs.forEach(input => {

                const validationSpan = document.querySelector(
                    `[data-valmsg-for="${input.name}"]`
                );

                if (validationSpan) {
                    validationSpan.innerText = "";
                }

                if (!input.value.trim()) {

                    isValid = false;

                    if (validationSpan) {
                        validationSpan.innerText = "This field is required";
                    }
                }
            });

            if (!isValid) {

                e.preventDefault();

                document.getElementById("contact")
                    .scrollIntoView({
                        behavior: "smooth"
                    });
            }

        });

        @if (TempData["ContactError"] != null)
        {
                <text>
                        document.getElementById("contact")
                            .scrollIntoView({
                                behavior: "smooth"
                            });
                </text>
        }

    });


        document.addEventListener("DOMContentLoaded", function () {

        const toast = document.getElementById("toast");
        const toastMessage = document.getElementById("toastMessage");

        function showToast(message, isSuccess = true) {

            toastMessage.innerText = message;

            toast.classList.remove("toast-success", "toast-error");

            if (isSuccess) {
                toast.classList.add("toast-success");
            } else {
                toast.classList.add("toast-error");
            }

            toast.classList.add("show");

            setTimeout(() => {
                toast.classList.remove("show");
            }, 3500);
        }

        @if (TempData["Success"] != null)
        {
                <text>
                        showToast("@TempData["Success"]", true);
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                        showToast("@TempData["Error"]", false);
                </text>
        }

    });
</script>