@model OnlineInsuranceManagementSystem.ViewModels.ContactMessageViewModel

<!-- Toast Notification -->
<div id="toast" class="toast toast-success">
    <i class="fas fa-check-circle mr-2"></i>
    <span id="toastMessage">Success!</span>
</div>

<!-- ========== NAVBAR ========== -->
<nav id="navbar" class="fixed top-0 left-0 w-full z-50 glass border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-20">
            <!-- Logo -->
            <a href="#home" class="flex items-center group">
                <div class="w-32 h-32 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <img id="navbarLogo"
                         src="../images/NAVBAR_LOGO_LIGHT_MODE.png"
                         alt="OIMS Logo"
                         class="w-full h-full object-contain">
                </div>
            </a>

            <!-- Desktop Tab Navigation -->
            <div class="hidden lg:flex items-center">
                <div class="tab-nav-container" role="tablist" aria-label="Main Navigation">
                    <div class="tab-glider" id="tabGlider" aria-hidden="true"></div>
                        
                    <input type="radio" name="nav-tab" id="tab-home" class="tab-radio" value="0" checked>
                    <input type="radio" name="nav-tab" id="tab-services" class="tab-radio" value="1">
                    <input type="radio" name="nav-tab" id="tab-features" class="tab-radio" value="2">
                    <input type="radio" name="nav-tab" id="tab-testimonials" class="tab-radio" value="3">
                    <input type="radio" name="nav-tab" id="tab-contact" class="tab-radio" value="4">
                        
                    <a href="#home" class="tab-link active" role="tab" aria-controls="home" data-tab="0" aria-selected="true">Home</a>
                    <a href="#services" class="tab-link" role="tab" aria-controls="services" data-tab="1" aria-selected="false">Services</a>
                    <a href="#features" class="tab-link" role="tab" aria-controls="features" data-tab="2" aria-selected="false">Features</a>
                    <a href="#testimonials" class="tab-link" role="tab" aria-controls="testimonials" data-tab="3" aria-selected="false">Testimonials</a>
                    <a href="#contact" class="tab-link" role="tab" aria-controls="contact" data-tab="4" aria-selected="false">Contact</a>
                </div>
            </div>

            <!-- Right Actions -->
            <div class="hidden lg:flex items-center space-x-4">
                <a href="/Account/Login" class="px-5 py-2 rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold transition-all">
                    Login
                </a>
                <a href="/Account/RegisterChoice" class="btn-accent px-5 py-2 rounded-full text-white font-semibold">
                    Register
                </a>
            </div>

            <!-- Mobile Menu Toggle -->
            <div class="flex lg:hidden items-center">
                <button id="hamburger" class="hamburger flex flex-col space-y-1.5 p-2" aria-label="Toggle mobile menu" aria-expanded="false" aria-controls="mobileMenu">
                    <span class="w-6 h-0.5 block"></span>
                    <span class="w-6 h-0.5 block"></span>
                    <span class="w-6 h-0.5 block"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="lg:hidden hidden bg-white border-t border-border">
        <div class="px-4 py-4 space-y-3">
            <a href="#home" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Home</a>
            <a href="#services" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Services</a>
            <a href="#features" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Features</a>
            <a href="#testimonials" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Testimonials</a>
            <a href="#contact" class="block py-2 px-4 rounded-lg text-gray-600 hover:bg-primary hover:text-white font-medium transition-colors mobile-link">Contact</a>
            <div class="pt-3 border-t border-border space-y-3">
                <a href="/Account/Login" class="w-full py-2.5 rounded-lg border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold transition-all text-center block">Login</a>
                <a href="/Account/RegisterChoice" class="w-full btn-accent py-2.5 rounded-lg text-white font-semibold text-center block">Register</a>
            </div>
        </div>
    </div>
</nav>

<!-- ========== HERO SECTION ========== -->
<section id="home" class="hero-section min-h-screen flex items-center relative overflow-hidden pt-20">
    
    <!-- Floating Shapes -->
    <div class="absolute top-20 left-10 w-20 h-20 rounded-full bg-white/10 animate-float"></div>
    <div class="absolute bottom-20 right-20 w-32 h-32 rounded-full bg-white/5 animate-float" style="animation-delay: 1s;"></div>
    <div class="absolute top-40 right-40 w-16 h-16 rounded-full bg-white/10 animate-float" style="animation-delay: 2s;"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">

            <!-- Left Content -->
            <div class="text-white space-y-8 animate-fadeInLeft">
                <div class="inline-flex items-center space-x-2 bg-white px-4 py-2 rounded-full border border-border">
                    <i class="fas fa-star text-success"></i>
                    <span class="text-sm font-medium text-deep">Trusted by 50,000+ Customers</span>
                </div>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
                    Protect What<br>
                    <span class="text-primary">Matters Most</span><br>
                    To You
                </h1>

                <p class="text-lg text-white/80 max-w-lg leading-relaxed">
                    Comprehensive insurance solutions tailored to your life. From health to home, we've got you covered with premium policies and hassle-free claims.
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/Account/GetStarted"
                       class="px-8 py-4 rounded-full text-white font-bold text-lg bg-[#08979D] hover:bg-[#23BBB7] text-center">
                        <i class="fas fa-rocket mr-2"></i> Get Started Free
                    </a>

                    <a href="#services"
                           class="px-8 py-4 rounded-full
                        bg-transparent text-white
                        border border-white
                        hover:bg-white hover:text-black
                        font-bold text-lg transition-all text-center">
                        
                        <i class="fas fa-eye mr-2"></i> View Plans
                    </a>
                </div>

                <!-- Trust Badges -->
                <div class="flex items-center space-x-6 pt-4">
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <span class="text-sm text-white/80">24/7 Support</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <span class="text-sm">Instant Claims</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-check-circle text-success"></i>
                        <span class="text-sm">Best Rates</span>
                    </div>
                </div>
            </div>

            <!-- Right Content -->
            <div class="animate-fadeInRight">
                <div class="rounded-3xl p-8 backdrop-blur-xl bg-slate-800/70 border border-white/20 shadow-2xl">
                    
                    <h3 class="text-white text-xl font-bold mb-6 flex items-center">
                        <i class="fas fa-calculator mr-2 text-success"></i> Quick Premium Estimator
                    </h3>

                    <div class="space-y-5">

                        <div>
                            <label class="text-success text-sm font-medium mb-2 block">
                                Insurance Type
                            </label>
                            <select id="heroInsType"
                                    class="w-full px-4 py-3 rounded-xl
                                bg-white
                                border border-border
                                text-gray-800
                                focus:outline-none focus:border-secondary">
                                
                                <option value="life">Life Insurance</option>
                                <option value="medical">Medical Insurance</option>
                                <option value="motor">Motor Insurance</option>
                                <option value="home">Home Insurance</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-success text-sm font-medium mb-2 block">
                                Coverage Amount: $<span id="heroCoverageValue">50,000</span>
                            </label>
                            <input type="range" id="heroCoverage" min="10000" max="500000" step="10000" value="50000" class="calc-slider">
                        </div>

                        <div>
                            <label class="text-success text-sm font-medium mb-2 block">
                                Your Age
                            </label>
                            <input type="number" id="heroAge" placeholder="e.g., 30"
                                   class="w-full px-4 py-3 rounded-xl
                            bg-white
                            border border-border
                            text-gray-800
                            placeholder-gray-400
                            focus:outline-none focus:border-secondary">
                        </div>

                        <button onclick="calculateHeroPremium()"
                                class="w-full btn-accent py-3 rounded-xl text-white font-bold text-lg">
                            Calculate Premium
                        </button>

                        <div id="heroPremiumResult"
                             class="hidden bg-white rounded-xl p-4 text-center border border-border">
                            
                            <p class="text-gray-600 text-sm">
                                Estimated Monthly Premium
                            </p>

                            <p class="text-3xl font-bold text-success" id="heroPremiumAmount">
                                $0
                            </p>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ========== INSURANCE SERVICES ========== -->
<section id="services" class="py-20 lg:py-28 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <span class="text-success font-semibold text-sm uppercase tracking-wider">Our Services</span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-3 text-gray-800">
                Insurance <span class="text-primary">Solutions</span>
            </h2>
            <div class="section-divider mx-auto mt-4"></div>
            <p class="text-muted mt-6 max-w-2xl mx-auto text-lg">Choose from our comprehensive range of insurance policies designed to protect every aspect of your life.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Life Insurance -->
            <a href="/Account/ServiceRedirect?service=life" class="service-card reveal bg-white rounded-2xl p-8 group cursor-pointer block no-underline">
                <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i class="fas fa-heart-pulse text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">Life Insurance</h3>
                <p class="text-muted text-sm leading-relaxed mb-4">Secure your family's future with comprehensive life coverage. Term, whole life, and endowment plans available.</p>
                <div class="flex items-center text-success font-semibold text-sm group-hover:text-primary transition-colors">
                    <span>Learn More</span>
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                </div>
            </a>

            <!-- Medical Insurance -->
            <a href="/Account/ServiceRedirect?service=medical" class="service-card reveal bg-white rounded-2xl p-8 group cursor-pointer block no-underline"
                style="transition-delay: 0.1s;">
                <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i class="fas fa-hospital text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">Medical Insurance</h3>
                <p class="text-muted text-sm leading-relaxed mb-4">Access top healthcare facilities with cashless treatment. Family floater and individual health plans.</p>
                <div class="flex items-center text-success font-semibold text-sm group-hover:text-primary transition-colors">
                    <span>Learn More</span>
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                </div>
            </a>

            <!-- Motor Insurance -->
            <a href="/Account/ServiceRedirect?service=motor" class="service-card reveal bg-white rounded-2xl p-8 group cursor-pointer block no-underline"
                style="transition-delay: 0.2s;">
                <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i class="fas fa-car text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">Motor Insurance</h3>
                <p class="text-muted text-sm leading-relaxed mb-4">Drive with confidence. Comprehensive and third-party vehicle insurance with quick claim settlement.</p>
                <div class="flex items-center text-success font-semibold text-sm group-hover:text-primary transition-colors">
                    <span>Learn More</span>
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                </div>
            </a>

            <!-- Home Insurance -->
            <a href="/Account/ServiceRedirect?service=home" class="service-card reveal bg-white rounded-2xl p-8 group cursor-pointer block no-underline"
                style="transition-delay: 0.3s;">
                <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i class="fas fa-house-chimney text-white text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">Home Insurance</h3>
                <p class="text-muted text-sm leading-relaxed mb-4">Protect your property and belongings. Coverage against fire, theft, natural disasters, and more.</p>
                <div class="flex items-center text-success font-semibold text-sm group-hover:text-primary transition-colors">
                    <span>Learn More</span>
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ========== FEATURES SECTION ========== -->
