                    <i class="fas fa-sliders text-accent text-2xl group-hover:text-white transition-colors"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mb-2">Policy Management</h3>
                <p class="text-muted text-sm">Manage all your policies from a single dashboard with real-time updates.</p>
            </div>
        </div>
    </div>
</section>

