<!-- ========== PREMIUM CALCULATOR SECTION ========== -->
<section id="calculator" class="calculator-section py-20 lg:py-28 relative overflow-hidden">

    <!-- Light Overlay -->
    <div class="absolute inset-0 bg-black/30"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Heading -->
        <div class="text-center mb-16 reveal">
            <span class="text-background font-semibold text-sm uppercase tracking-wider">Smart Tool</span>
            
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-3 text-white">
                Premium <span style="color:#23BBB7;">Calculator</span>
            </h2>
            
            <div class="section-divider mx-auto mt-4"></div>
        </div>

        <!-- Calculator Card -->
        <div class="reveal bg-white/95 backdrop-blur-md rounded-3xl p-8 lg:p-12 border border-border">
            
            <div class="grid md:grid-cols-2 gap-8">

                <!-- Left Inputs -->
                <div class="space-y-6">
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Insurance Type
                        </label>
                        <select id="calcType" class="w-full px-4 py-3 rounded-xl border border-border text-gray-800 focus:outline-none">
                            <option value="life">Life Insurance</option>
                            <option value="medical">Medical Insurance</option>
                            <option value="motor">Motor Insurance</option>
                            <option value="home">Home Insurance</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Coverage Amount
                        </label>
                        <input type="number" id="calcCoverage" placeholder="e.g., 100000"
                               class="w-full px-4 py-3 rounded-xl border border-border text-gray-800 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Your Age
                        </label>
                        <input type="number" id="calcAge" placeholder="e.g., 30"
                               class="w-full px-4 py-3 rounded-xl border border-border text-gray-800 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Policy Term (Years)
                        </label>
                        <input type="range" id="calcTerm" min="5" max="40" value="20" class="calc-slider">
                        
                        <div class="flex justify-between text-xs text-gray-600 mt-1">
                            <span>5 years</span>
                            <span id="calcTermValue" class="font-bold" style="color:#025f67;">20 years</span>
                            <span>40 years</span>
                        </div>
                    </div>

                </div>

                <!-- Right Output -->
                <div class="flex flex-col justify-center items-center space-y-6">
                    
                    <div class="text-center">
                        <p class="text-sm mb-1" style="color:#898F99;">
                            Estimated Monthly Premium
                        </p>

                        <h3 class="text-5xl font-extrabold" style="color:#025f67;" id="calcPremium">
                            $0.00
                        </h3>
                    </div>

                    <div class="text-center space-y-2">
                        <p class="text-sm" style="color:#898F99;">
                            Annual Premium:
                            <span id="calcAnnual" class="font-semibold text-gray-800">$0.00</span>
                        </p>

                        <p class="text-sm" style="color:#898F99;">
                            Total over Term:
                            <span id="calcTotal" class="font-semibold text-gray-800">$0.00</span>
                        </p>
                    </div>

                    <button onclick="calculatePremium()"
                            class="w-full py-3 rounded-xl text-white font-bold text-lg"
                            style="background:#2F9D94;">
                        <i class="fas fa-calculator mr-2"></i> Calculate Now
                    </button>

                </div>

            </div>
        </div>

    </div>
</section>

<!-- ========== CONTACT SECTION ========== -->
<section id="contact" class="py-20 lg:py-28 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <span class="text-success font-semibold text-sm uppercase tracking-wider">Get In Touch</span>
