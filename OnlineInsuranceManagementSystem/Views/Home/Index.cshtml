                Contact <span class="text-primary">Us</span>
            </h2>
            <div class="section-divider mx-auto mt-4"></div>
        </div>

        <div class="grid lg:grid-cols-5 gap-12">
            <!-- Contact Info -->
            <div class="lg:col-span-2 space-y-8 reveal">
                <div class="bg-white rounded-2xl p-6 border border-border flex items-start space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-location-dot text-accent text-xl"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-800">Our Office</h4>
                        <p class="text-muted text-sm mt-1">123 Insurance Tower, Financial District, NY 10001</p>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-border flex items-start space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-success/10 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-phone text-accent text-xl"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-800">Phone</h4>
                        <p class="text-muted text-sm mt-1">+1 (800) 555-0199</p>
                        <p class="text-muted text-sm mt-1">Mon-Fri: 9AM - 6PM</p>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-border flex items-start space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-envelope text-accent text-xl"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-800">Email</h4>
                        <p class="text-muted text-sm mt-1">support@oims.com</p>
                        <p class="text-muted text-sm mt-1">24/7 Email Support</p>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="lg:col-span-3 reveal">
                <form method="post"
                      asp-action="SendMessage"
                      asp-controller="Account"
                      id="contactForm"
                      novalidate
                      class="bg-white rounded-2xl p-8 border border-border">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-red-500 text-sm mb-4">
                    </div>

                    <div class="grid md:grid-cols-2 gap-6 mb-6">

                        <!-- Full Name -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-input w-full px-4 py-3 rounded-xl focus:outline-none" />

                            <span asp-validation-for="FullName"
                                  class="text-red-500 text-xs mt-1"></span>
                        </div>

                        <!-- Email -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-input w-full px-4 py-3 rounded-xl focus:outline-none" />

                            <span asp-validation-for="Email"
                                  class="text-red-500 text-xs mt-1"></span>
                        </div>

                    </div>

                    <!-- Subject -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Subject
                        </label>

                        <input asp-for="Subject"
                               class="form-input w-full px-4 py-3 rounded-xl focus:outline-none" />

                        <span asp-validation-for="Subject"
                              class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Message -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Message
                        </label>

                        <textarea asp-for="Message"
                                  rows="5"
                                  class="form-input w-full px-4 py-3 rounded-xl focus:outline-none resize-none"></textarea>

                        <span asp-validation-for="Message"
                              class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <button type="submit"
                            class="w-full btn-accent py-3 rounded-xl text-white font-bold text-lg">

                        <i class="fas fa-paper-plane mr-2"></i>
                        Send Message

                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

