                <h3 class="text-4xl lg:text-5xl font-extrabold mb-2"><span class="counter" data-target="99">0</span>%</h3>
                <p class="text-white/70 font-medium">Satisfaction Rate</p>
            </div>
        </div>
    </div>
</section>

