@model List<OnlineInsuranceManagementSystem.ViewModels.AgentApplicationViewModel>
@{
    ViewData["Title"] = "My Applications";
    Layout = "~/Views/Shared/_AgentLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header (No Add button for Agent) -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Assigned Applications</h4>
            </div>

            <!-- TOP SUMMARY CARDS (Same design) -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-file-earmark-text text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Assigned</h6>
                                <small class="text-muted" id="totalApplications">@ViewBag.TotalApplications</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hourglass-split text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending</h6>
                                <small class="text-muted" id="pendingApplications">@ViewBag.PendingApplications</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Approved</h6>
                                <small class="text-muted" id="approvedApplications">@ViewBag.ApprovedApplications</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-x-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Rejected</h6>
                                <small class="text-muted" id="rejectedApplications">@ViewBag.RejectedApplications</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter (Same design) -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Application ID</label>
                            <input type="text" id="searchAppId"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter application ID..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Customer/Policy</label>
                            <input type="text" id="searchName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter customer or policy name..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Filter Status</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill active" data-filter="all">All</button>
                                <button class="btn btn-sm btn-outline-warning rounded-pill" data-filter="pending">Pending</button>
                                <button class="btn btn-sm btn-outline-success rounded-pill" data-filter="approved">Approved</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill" data-filter="rejected">Rejected</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">All Assigned Applications</h4>
                            <small class="text-muted">Applications assigned to you for review</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'applicationsTable', 'Applications')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'applicationsTable', 'Applications')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="applicationsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Application ID</th>
                                    <th>Customer Name</th>
                                    <th>Policy Name</th>
                                    <th>Apply Date</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model)
                                {
                                    <tr data-status="@app.Status.ToLower()">
                                        <td>@app.ApplicationIdDisplay</td>
                                        <td>@app.UserName</td>
                                        <td>@app.PolicyName</td>
                                        <td>@app.ApplyDateDisplay</td>
                                        <td>
                                            <span class="badge @app.StatusBadgeClass">@app.StatusText</span>
                                        </td>
                                        <td>
                                            <span class="text-muted small">@(string.IsNullOrEmpty(app.Remarks) ? "-" : app.Remarks)</span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm d-flex gap-2">
                                                <!-- VIEW BUTTON -->
                                                <button class="btn btn-outline-info view-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#viewApplicationModal"
                                                        data-appid="@app.ApplicationId"
                                                        data-username="@app.UserName"
                                                        data-policyname="@app.PolicyName"
                                                        data-agentname="@(app.AgentName ?? "-")"
                                                        data-applydate="@app.ApplyDateDisplay"
                                                        data-status="@app.Status"
                                                        data-remarks="@(app.Remarks ?? "-")"
                                                        title="View Details">
                                                    View
                                                </button>

                                                <!-- APPROVE BUTTON -->
                                                <button type="button"
                                                        class="btn btn-outline-success approve-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#approveModal"
                                                        data-appid="@app.ApplicationId"
                                                        title="Approve Application"
                                                    @(app.Status == "Approved" ? "disabled" : "")>
                                                    Approve
                                                </button>

                                                <!-- REJECT BUTTON -->
                                                <form asp-action="RejectApplication" asp-controller="Agent" method="post" class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to REJECT this application?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@app.ApplicationId" />
                                                    <button type="button"
                                                            class="btn btn-outline-danger reject-btn"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#rejectModal"
                                                            data-appid="@app.ApplicationId"
                                                            title="Reject Application">
                                                        Reject
                                                    </button>
                                                </form>

                                                <!-- REMARKS BUTTON -->
                                                <button class="btn btn-outline-secondary remarks-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#remarksModal"
                                                        data-appid="@app.ApplicationId"
                                                        data-currentremarks="@(app.Remarks == "-" ? "" : app.Remarks)"
                                                        title="Add/Edit Remarks">
                                                    Remarks
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Applications: @Model.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW APPLICATION MODAL (identical) ==================== -->
<div class="modal fade" id="viewApplicationModal" tabindex="-1" aria-labelledby="viewApplicationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-file text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewApplicationModalLabel">Application Details</h5>
                        <small class="text-muted" id="viewApplicationIdDisplay">#APP-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Customer Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewUserName">-</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-shield me-1"></i>Policy Name</label>
                            <p class="form-control-plaintext mb-0" id="viewPolicyName">-</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-person me-1"></i>Agent Name</label>
                            <p class="form-control-plaintext mb-0" id="viewAgentName">-</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Application Date</label>
                            <p class="form-control-plaintext mb-0" id="viewApplyDate">-</p>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-note me-1"></i>Remarks</label>
                                <p class="form-control-plaintext mb-0" id="viewRemarks">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== REMARKS MODAL (Agent only) ==================== -->
<div class="modal fade" id="remarksModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Add/Edit Remarks</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="UpdateRemarks" asp-controller="Agent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="remarksAppId" name="id" />
                    <div class="mb-3">
                        <label for="remarksText" class="form-label"></label>
                        <textarea id="remarksText" name="remarks" class="form-control rounded-3" rows="4"
                                  placeholder="Enter your remarks here..."></textarea>
                    </div>
                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Save Remarks</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== REJECT APPLICATION MODAL ==================== -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <!-- Header -->
            <div class="modal-header border-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger-subtle rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;">
                        <i class="bi bi-x-circle text-danger"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Reject Application</h5>
                        <small class="text-muted">Provide reason before rejecting</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body pt-2">
                <form asp-action="RejectApplication" asp-controller="Agent" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="rejectAppId" name="id" />

                    <div class="mb-3">
                        <label class="form-label"></label>
                        <textarea name="remarks"
                                  id="rejectReason"
                                  class="form-control rounded-3"
                                  rows="4"
                                  placeholder="Enter reason for rejection..."
                                  required></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button"
                                class="btn btn-light rounded-pill px-4"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-danger rounded-pill px-4">
                            Reject Application
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- ==================== APPROVE APPLICATION MODAL ==================== -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header border-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-success-subtle rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px;height:40px;">
                        <i class="bi bi-check-circle text-success"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Approve Application</h5>
                        <small class="text-muted">
                            Confirm approval of this application
                        </small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="mb-0">
                    Are you sure you want to approve this application?
                </p>
            </div>

            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-light rounded-pill px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="ApproveApplication"
                      asp-controller="Agent"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="approveAppId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-success rounded-pill px-4">
                        Approve Application
                    </button>

                </form>

            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Same as Admin) ==================== -->
<style>
    .custom-card {
        border-radius: 20px;
        transition: transform 0.2s, box-shadow 0.2s;
        border: none;
        background: white;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #eef2ff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .trend-icon {
        font-size: 20px;
        color: #10b981;
        opacity: 0.7;
    }

    .table > :not(caption) > * > * {
        padding: 1rem 0.75rem;
    }

    .page-link {
        border-radius: 30px !important;
        margin: 0 2px;
        color: #4b5563;
    }

    .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    @@media (max-width: 768px) {
        .btn-group {
            flex-direction: column;
            gap: 5px;
        }

            .btn-group .btn {
                width: 100%;
            }
    }
</style>

<!-- ==================== JAVASCRIPT (Search, Filter, Pagination, Export, Remarks) ==================== -->
@section Scripts {
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        // ---------- SEARCH ----------
        const searchAppId = document.getElementById('searchAppId');
        const searchName = document.getElementById('searchName');

        function filterTable() {
        const appIdVal = searchAppId.value.toLowerCase();
        const nameVal = searchName.value.toLowerCase();

        document.querySelectorAll("#applicationsTable tbody tr").forEach(row => {
        const appId = row.cells[0]?.textContent.toLowerCase() || '';
        const customerName = row.cells[1]?.textContent.toLowerCase() || '';
        const policyName = row.cells[2]?.textContent.toLowerCase() || '';

        const matches = (appId.includes(appIdVal)) &&
        (customerName.includes(nameVal) || policyName.includes(nameVal));
        row.style.display = matches ? "" : "none";
        });
        updatePaginationAfterFilter();
        }

        searchAppId.addEventListener("input", filterTable);
        searchName.addEventListener("input", filterTable);

        // ---------- STATUS FILTER ----------
        document.querySelectorAll("[data-filter]").forEach(btn => {
        btn.addEventListener("click", function () {
        document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
        this.classList.add("active");

        const filter = this.getAttribute('data-filter');
        const rows = document.querySelectorAll("#applicationsTable tbody tr");
        rows.forEach(row => {
        const rowStatus = row.getAttribute('data-status');
        if (filter === 'all' || filter === rowStatus) {
        row.style.display = "";
        } else {
        row.style.display = "none";
        }
        });
        updatePaginationAfterFilter();
        });
        });

        // ---------- PAGINATION ----------
        let currentPage = 1;
        const rowsPerPage = 10;

        function updatePaginationAfterFilter() {
        const visibleRows = Array.from(document.querySelectorAll("#applicationsTable tbody tr"))
        .filter(row => row.style.display !== "none");
        const pageCount = Math.ceil(visibleRows.length / rowsPerPage);
        currentPage = Math.min(currentPage, pageCount) || 1;
        displayTablePage(currentPage, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        }

        function displayTablePage(page, visibleRows) {
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        document.querySelectorAll("#applicationsTable tbody tr").forEach(row => {
        if (row.style.display === "none") return;
        const index = visibleRows.indexOf(row);
        row.style.display = (index >= start && index < end) ? "" : "none";
        });
        }

        function renderPaginationControls(pageCount, visibleRows) {
        const pagination = document.getElementById("pagination");
        pagination.innerHTML = "";

        if (pageCount <= 1) return;

        // Prev
        const prevLi = document.createElement("li");
        prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
        prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
        prevLi.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentPage > 1) {
        currentPage--;
        displayTablePage(currentPage, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        }
        });
        pagination.appendChild(prevLi);

        for (let i = 1; i <= pageCount; i++) {
        const li = document.createElement("li");
        li.className = `page-item ${currentPage === i ? "active" : ""}`;
        li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
        li.addEventListener("click", (e) => {
        e.preventDefault();
        currentPage = i;
        displayTablePage(currentPage, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        });
        pagination.appendChild(li);
        }

        // Next
        const nextLi = document.createElement("li");
        nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
        nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
        nextLi.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentPage < pageCount) {
        currentPage++;
        displayTablePage(currentPage, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        }
        });
        pagination.appendChild(nextLi);
        }

        // Initial pagination setup
        function initPagination() {
        const allRows = Array.from(document.querySelectorAll("#applicationsTable tbody tr"));
        const visibleRows = allRows.filter(row => row.style.display !== "none");
        const pageCount = Math.ceil(visibleRows.length / rowsPerPage);
        currentPage = 1;
        displayTablePage(1, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        }
        initPagination();

        // ---------- VIEW MODAL POPULATION ----------
        const viewModal = document.getElementById('viewApplicationModal');
        viewModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        document.getElementById('viewApplicationIdDisplay').textContent = `#APP-${button.getAttribute('data-appid')}`;
        document.getElementById('viewUserName').textContent = button.getAttribute('data-username') || '-';
        document.getElementById('viewPolicyName').textContent = button.getAttribute('data-policyname') || '-';
        document.getElementById('viewAgentName').textContent = button.getAttribute('data-agentname') || '-';
        document.getElementById('viewApplyDate').textContent = button.getAttribute('data-applydate') || '-';
        document.getElementById('viewRemarks').textContent = button.getAttribute('data-remarks') || '-';

        const status = button.getAttribute('data-status');
        const statusBadge = document.getElementById('viewStatusBadge');
        const statusLower = status?.toLowerCase();
        if (statusLower === 'approved') {
        statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
        statusBadge.textContent = 'Approved';
        } else if (statusLower === 'rejected') {
        statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
        statusBadge.textContent = 'Rejected';
        } else {
        statusBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
        statusBadge.textContent = 'Pending';
        }
        });

        // ---------- REMARKS MODAL POPULATION ----------
        const remarksModal = document.getElementById('remarksModal');
        remarksModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const appId = button.getAttribute('data-appid');
        const currentRemarks = button.getAttribute('data-currentremarks') || '';
        document.getElementById('remarksAppId').value = appId;
        document.getElementById('remarksText').value = currentRemarks;
        });

        // ---------- REJECT MODAL POPULATION ----------
        const rejectModal = document.getElementById('rejectModal');

        rejectModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const appId = button.getAttribute('data-appid');

        document.getElementById('rejectAppId').value = appId;
        document.getElementById('rejectReason').value = "";
        });

        // ---------- APPROVE MODAL POPULATION ----------
        const approveModal = document.getElementById('approveModal');

        approveModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const appId = button.getAttribute('data-appid');

        document.getElementById('approveAppId').value = appId;
        });

        // ---------- EXPORT FUNCTIONS (same as Admin) ----------
        // Inside exportTable function in Agent/Applications.cshtml
        window.exportTable = function (type, tableId, filename) {
        const table = document.getElementById(tableId);

        // ✅ Ensure we only export rows that belong to this agent
        // (The server-side filter already ensures this, but this is a safety net)
        const rows = table.querySelectorAll('tbody tr');
        const data = [];

        // Add header
        const headerRow = table.querySelector('thead tr');
        const headers = Array.from(headerRow.querySelectorAll('th, td')).map(th => th.innerText.trim());
        data.push(headers);

        // Add only visible (filtered) rows
        for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        if (row.style.display === "none") continue; // Skip filtered-out rows

        const rowData = [];
        const cols = row.querySelectorAll('th, td');
        for (let j = 0; j < cols.length; j++) {
        let text = cols[j].innerText.trim();
        if (j === 0 && text.startsWith('#APP-')) text = text.replace('#APP-', '');
        rowData.push(text);
        }
        data.push(rowData);
        }

        if (type === 'excel') {
        const ws = XLSX.utils.aoa_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Applications');
        XLSX.writeFile(wb, `${filename}.xlsx`);
        } else if (type === 'pdf') {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape' });
        doc.autoTable({
        head: [data[0]],
        body: data.slice(1),
        theme: 'striped',
        styles: { fontSize: 8, cellPadding: 2 },
        headStyles: { fillColor: [13, 110, 253] }
        });
        doc.save(`${filename}.pdf`);
        }
        };
        });
    </script>
}