@model OnlineInsuranceManagementSystem.ViewModels.AgentDashboardViewModel
@{
    ViewData["Title"] = "Agent Dashboard";
    Layout = "~/Views/Shared/_AgentLayout.cshtml";
}

@functions {
    public string GetStatusBadge(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "warning",
            "approved" => "success",
            "rejected" => "danger",
            "recommended-approve" => "info",
            "recommended-reject" => "warning",
            _ => "secondary"
        };
    }
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <div>
                    <h4 class="mb-0">Welcome back, @ViewBag.AgentName ! </h4>
                    <small class="text-muted">Here's what's happening with your assigned applications</small>
                </div>
                <span class="badge bg-label-primary rounded-pill px-3 py-2">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- ==================== SUMMARY CARDS (Agent-Specific) ==================== -->
            <div class="row g-3 mb-4">
                <!-- Total Applications -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-file-earmark-text text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Applications</h6>
                                <small class="text-muted" id="totalApplications">@Model.TotalApplications.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                        @if (Model.TotalApplications > 0)
                        {
                            <div class="mt-2 px-3 pb-3">
                                <a asp-action="Applications" class="text-primary small text-decoration-none">
                                    View All <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Pending Applications -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hourglass-split text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Review</h6>
                                <small class="text-muted" id="pendingApplications">@Model.PendingApplications.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                        @if (Model.PendingApplications > 0)
                        {
                            <div class="mt-2 px-3 pb-3">
                                <a asp-action="Applications" class="text-warning small text-decoration-none">
                                    Review Now <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Approved Applications -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Approved</h6>
                                <small class="text-muted" id="approvedApplications">@Model.ApprovedApplications.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Rejected Applications -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-x-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Rejected</h6>
                                <small class="text-muted" id="rejectedApplications">@Model.RejectedApplications.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- Total Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-clipboard2-check text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Claims</h6>
                                <small class="text-muted" id="totalClaims">@Model.TotalClaims.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                        @if (Model.TotalClaims > 0)
                        {
                            <div class="mt-2 px-3 pb-3">
                                <a asp-action="Claims" class="text-primary small text-decoration-none">
                                    View Claims <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Pending Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-exclamation-triangle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Claims</h6>
                                <small class="text-muted" id="pendingClaims">@Model.PendingClaims.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                        @if (Model.PendingClaims > 0)
                        {
                            <div class="mt-2 px-3 pb-3">
                                <a asp-action="Claims" class="text-danger small text-decoration-none">
                                    Review <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Recommended Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box position-relative">
                                    <i class="bi bi-hand-thumbs-up text-dark"></i>
                                    @if (Model.RecommendedClaims > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info"
                                              style="font-size: 0.65rem; padding: 0.25em 0.45em;">
                                            @Model.RecommendedClaims
                                        </span>
                                    }
                                </div>
                                <h6 class="card-title mt-3 mb-1">Recommended</h6>
                                <small class="text-muted" id="recommendedClaims">@Model.RecommendedClaims.ToString("N0")</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                        @if (Model.RecommendedClaims > 0)
                        {
                            <div class="mt-2 px-3 pb-3">
                                <small class="text-info small">Awaiting Admin approval</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100 bg-primary text-white">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <h6 class="card-title mb-3"><i class="bi bi-lightning-charge me-2"></i>Quick Actions</h6>
                            <div class="d-grid gap-2">
                                <a asp-action="Applications" class="btn btn-light btn-sm rounded-pill">
                                    <i class="bi bi-file-earmark me-1"></i>My Applications
                                </a>
                                <a asp-action="Claims" class="btn btn-light btn-sm rounded-pill" ">
                                    <i class="bi bi-clipboard2 me-1"></i>Claims Review
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- ==================== RECENT ACTIVITY SECTION ==================== -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Recent Activity</h4>
                            <small class="text-muted">Latest applications and claims for your review</small>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Applications" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-file-earmark me-1"></i>Applications
                            </a>
                            <a asp-action="Claims" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-clipboard2-check me-1"></i>Claims
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="row g-4">
                        <!-- Recent Applications List -->
                        <div class="col-lg-6 d-flex">
                            <div class="w-100 h-100">
                                <h6 class="fw-semibold mb-3">
                                    <i class="bi bi-file-earmark-text text-primary me-2"></i>Recent Applications
                                </h6>
                                @if (Model.RecentApplications.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var app in Model.RecentApplications)
                                        {
                                            <div class="list-group-item border-0 px-0 py-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-1 fw-medium small">@app.CustomerName</h6>
                                                        <p class="small text-muted mb-1">@app.PolicyName</p>
                                                        <span class="badge bg-@GetStatusBadge(app.Status) rounded-pill small">
                                                            @app.Status
                                                        </span>
                                                    </div>
                                                    <div class="text-end">
                                                        <small class="text-muted">@app.ApplyDate.ToString("dd MMM")</small>
                                                        <p class="fw-semibold small mb-0 text-primary">#APP-@app.ApplicationId</p>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-file-earmark-x fs-4 d-block mb-2"></i>
                                        <small>No applications assigned yet</small>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Recent Claims List -->
                        <div class="col-lg-6 d-flex">
                            <div class="w-100 h-100">
                                <h6 class="fw-semibold mb-3">
                                    <i class="bi bi-clipboard2-check text-primary me-2"></i>Recent Claims
                                </h6>
                                @if (Model.RecentClaims.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var claim in Model.RecentClaims)
                                        {
                                            <div class="list-group-item border-0 px-0 py-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-1 fw-medium small">@claim.CustomerName</h6>
                                                        <p class="small text-muted mb-1">@claim.PolicyName</p>
                                                        <span class="badge bg-@GetStatusBadge(claim.Status) rounded-pill small">
                                                            @claim.Status?.Replace("Recommended-", "Rec: ")
                                                        </span>
                                                    </div>
                                                    <div class="text-end">
                                                        <p class="fw-semibold small mb-1 text-primary">Rs. @claim.ClaimAmount.ToString("N0")</p>
                                                        <small class="text-muted">@claim.ClaimDate.ToString("dd MMM")</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-clipboard2-x fs-4 d-block mb-2"></i>
                                        <small>No claims to review</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* <!-- ==================== AGENT TIPS SECTION ==================== -->
            <div class="alert alert-info rounded-4 mb-0">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-lightbulb fs-4"></i>
                    <div>
                        <h6 class="mb-1"> Agent Tips</h6>
                        <ul class="mb-0 small">
                            <li>Review pending applications first to keep your pipeline moving</li>
                            <li>Add detailed remarks to help Admin make faster decisions</li>
                            <li>Use the "Recommend" feature for claims to expedite processing</li>
                            <li>Check the charts above to track your monthly performance</li>
                        </ul>
                    </div>
                </div>
            </div> *@

        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Identical to Admin Dashboard) ==================== -->
<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #f8f9fa;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        transition: background 0.2s ease;
    }

    .custom-card:hover .icon-box {
        background: #e9ecef;
    }

    .trend-icon {
        font-size: 1.5rem;
        color: #28a745;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .custom-card:hover .trend-icon {
        opacity: 1;
    }

    .badge.bg-label-primary {
        background-color: #cfe2ff !important;
        color: #0d6efd !important;
    }

    #applicationsChart, #statusPieChart {
        min-height: 280px;
    }

    .list-group-item {
        background: transparent !important;
    }

    .list-group-item-action:hover {
        background-color: #f8f9fa !important;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .card-header {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 0.5rem;
        }

            .card-header .btn,
            .card-header .badge {
                align-self: flex-end;
            }
    }
    /* Recent Activity Section Styles */
    .custom-card {
        background: #fff;
        border-radius: 24px !important;
        border: 1px solid #eef1f6 !important;
        box-shadow: 0 8px 30px rgba(16, 24, 40, 0.04);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .custom-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(16, 24, 40, 0.08);
        }

    .card-header {
        border-bottom: 1px solid #f1f3f7 !important;
        padding-bottom: 18px !important;
    }

    .card-body h6 {
        font-size: 15px;
        font-weight: 700;
        color: #2f3e52;
        margin-bottom: 18px !important;
    }

    .col-lg-6 {
        display: flex;
        flex-direction: column;
    }

    .list-group {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .list-group-item {
        border: 1px solid #edf1f7 !important;
        border-radius: 18px !important;
        background: #ffffff !important;
        padding: 16px !important;
        transition: all 0.25s ease;
        box-shadow: 0 2px 10px rgba(16, 24, 40, 0.03);
    }

        .list-group-item:hover {
            transform: translateY(-2px);
            background: #fafcff !important;
            border-color: #d9e7ff !important;
        }

        .list-group-item h6 {
            font-size: 14px;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 4px !important;
        }

        .list-group-item p {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 8px !important;
        }

    .text-end p {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px !important;
    }

    .text-end small {
        font-size: 12px;
        color: #9ca3af !important;
    }

    .badge {
        font-size: 11px !important;
        font-weight: 600 !important;
        padding: 7px 12px !important;
        border-radius: 50px !important;
        letter-spacing: 0.3px;
    }

        .badge.bg-warning {
            background: #fff8e1 !important;
            color: #b7791f !important;
        }

        .badge.bg-success {
            background: #dcfce7 !important;
            color: #15803d !important;
        }

        .badge.bg-danger {
            background: #fee2e2 !important;
            color: #dc2626 !important;
        }

        .badge.bg-info {
            background: #dbeafe !important;
            color: #1d4ed8 !important;
        }

    .card-header .btn {
        border-radius: 50px !important;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        transition: all 0.25s ease;
    }

    .text-center.py-4 {
        border: 2px dashed #e5e7eb;
        border-radius: 18px;
        padding: 30px !important;
        background: #fafafa;
    }

    @@media (max-width: 992px) {
        .col-lg-6 {
            margin-bottom: 20px;
        }
    }

    @@media (max-width: 768px) {
        .card-header .d-flex {
            flex-direction: column !important;
            align-items: flex-start !important;
        }

        .card-header .btn {
            width: 100%;
            justify-content: center;
        }

        .list-group-item {
            padding: 14px !important;
        }

            .list-group-item .d-flex {
                flex-direction: column;
                gap: 10px;
            }

        .text-end {
            text-align: left !important;
        }
    }
</style>

<!-- ==================== APEXCHARTS INITIALIZATION ==================== -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

        // ==================== MONTHLY APPLICATIONS CHART ====================
        const appsOptions = {
        series: [{
        name: 'Applications',
        data: [@string.Join(",", Model.MonthlyApplicationsData.Select(d => d.ApplicationsCount))]
        }],
        chart: {
        type: 'area',
        height: 280,
        toolbar: { show: false },
        fontFamily: 'Public Sans, sans-serif'
        },
        colors: ['#0d6efd'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 3, colors: ['#0d6efd'] },
        fill: {
        type: 'gradient',
        gradient: {
        shadeIntensity: 1,
        opacityFrom: 0.4,
        opacityTo: 0.1,
        stops: [0, 90, 100]
        }
        },
        xaxis: {
        categories: [@string.Join(",", Model.MonthlyApplicationsData.Select(d => $"'{d.Month}'"))],
        labels: { style: { colors: '#6c757d', fontSize: '11px' } },
        axisBorder: { show: false },
        axisTicks: { show: false }
        },
        yaxis: {
        labels: {
        style: { colors: '#6c757d', fontSize: '11px' },
        formatter: function(val) { return Math.round(val); }
        }
        },
        grid: {
        borderColor: '#e9ecef',
        strokeDashArray: 4,
        padding: { left: 10, right: 10 }
        },
        tooltip: {
        theme: 'light',
        y: { formatter: function(val) { return val + " applications"; } }
        },
        markers: {
        size: 4,
        colors: ['#0d6efd'],
        strokeColors: '#fff',
        strokeWidth: 2
        }
        };
        const appsChart = new ApexCharts(document.querySelector("#applicationsChart"), appsOptions);
        appsChart.render();

        // ==================== STATUS PIE CHART ====================
        const pieData = [@string.Join(",", Model.ApplicationsByStatus.Select(d =>
                    $"{{ name: '{d.Label}', value: {d.Value}, color: '{d.Color}' }}"))];

        if (pieData.length > 0) {
        const pieOptions = {
        series: [@string.Join(",", Model.ApplicationsByStatus.Select(d => d.Value))],
        chart: {
        type: 'donut',
        height: 280,
        toolbar: { show: false },
        fontFamily: 'Public Sans, sans-serif'
        },
        colors: [@string.Join(",", Model.ApplicationsByStatus.Select(d => $"'{d.Color}'"))],
        labels: [@string.Join(",", Model.ApplicationsByStatus.Select(d => $"'{d.Label}'"))],
        legend: {
        position: 'bottom',
        fontSize: '11px',
        labels: { colors: '#6c757d' }
        },
        plotOptions: {
        pie: {
        donut: {
        size: '65%',
        labels: {
        show: true,
        total: {
        show: true,
        label: 'Total',
        formatter: function(w) {
        return w.globals.seriesTotals.reduce((a, b) => a + b, 0);
        }
        }
        }
        }
        }
        },
        dataLabels: { enabled: false },
        tooltip: {
        theme: 'light',
        y: { formatter: function(val) { return val + " applications"; } }
        }
        };
        const pieChart = new ApexCharts(document.querySelector("#statusPieChart"), pieOptions);
        pieChart.render();
        } else {
        // Show empty state message
        document.querySelector("#statusPieChart").innerHTML =
        '<div class="text-center text-muted py-5"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i><small>No data available</small></div>';
        }
        });
    </script>
}