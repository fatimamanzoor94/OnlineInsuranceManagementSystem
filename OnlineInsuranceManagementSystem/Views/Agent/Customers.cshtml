@model List<OnlineInsuranceManagementSystem.ViewModels.AgentCustomerViewModel>
@{
    ViewData["Title"] = "My Customers";
    Layout = "~/Views/Shared/_AgentLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header (NO Add Button for Agent) -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">My Customers</h4>
                <small class="text-muted">Customers assigned to you via applications</small>
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-people text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Customers</h6>
                                <small class="text-muted" id="totalCustomers">@ViewBag.TotalCustomers</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Active</h6>
                                <small class="text-muted" id="activeCustomers">@ViewBag.ActiveCustomers</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hourglass-split text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Apps</h6>
                                <small class="text-muted" id="pendingApps">@ViewBag.PendingApps</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-shield-check text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Approved Apps</h6>
                                <small class="text-muted" id="approvedApps">@ViewBag.ApprovedApps</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Name</label>
                            <input type="text" id="searchName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter full name..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Email/Phone</label>
                            <input type="text" id="searchContact"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter email or phone..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Filter Application Status</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill active" data-filter="all">All</button>
                                <button class="btn btn-sm btn-outline-warning rounded-pill" data-filter="pending">Pending</button>
                                <button class="btn btn-sm btn-outline-success rounded-pill" data-filter="approved">Approved</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill" data-filter="rejected">Rejected</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Assigned Customers</h4>
                            <small class="text-muted">View customer details and application status</small>
                        </div>
                        <!-- Export Buttons -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'customersTable', 'MyCustomers')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'customersTable', 'MyCustomers')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="customersTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Customer ID</th>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Policy</th>
                                    <th>App Status</th>
                                    <th>Apply Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model)
                                {
                                    <tr data-app-status="@customer.ApplicationStatus?.ToLower()">
                                        <td>@customer.CustomerIdDisplay</td>
                                        <td>@customer.FullName</td>
                                        <td>@customer.Email</td>
                                        <td>@customer.Phone</td>
                                        <td><small class="text-muted">@customer.PolicyName</small></td>
                                        <td>
                                            <span class="badge @customer.AppStatusBadgeClass">
                                                @customer.ApplicationStatus
                                            </span>
                                        </td>
                                        <td>@customer.ApplyDateDisplay</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <!-- ✅ VIEW BUTTON ONLY (Read-Only for Agent) -->
                                                <button class="btn btn-outline-info view-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#viewCustomerModal"
                                                        data-customerid="@customer.UserId"
                                                        data-fullname="@customer.FullName"
                                                        data-email="@customer.Email"
                                                        data-phone="@customer.Phone"
                                                        data-address="@customer.Address"
                                                        data-status="@customer.Status"
                                                        data-createdat="@customer.CreatedAt.ToString("dd-MMM-yyyy")"
                                                        data-policyname="@customer.PolicyName"
                                                        data-appstatus="@customer.ApplicationStatus"
                                                        data-applydate="@customer.ApplyDateDisplay"
                                                        title="View Details">
                                                    View
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Customers: @Model.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW CUSTOMER DETAILS MODAL (Agent Version) ==================== -->
<div class="modal fade" id="viewCustomerModal" tabindex="-1" aria-labelledby="viewCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-user text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewCustomerModalLabel">Customer Details</h5>
                        <small class="text-muted" id="viewCustomerIdDisplay">#CUS-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Full Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewFullName">-</p>
                        </div>
                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-envelope me-1"></i>Email Address</label>
                            <p class="form-control-plaintext mb-0" id="viewEmail">
                                <a href="#" class="text-decoration-none" id="viewEmailLink">-</a>
                            </p>
                        </div>
                        <!-- Phone -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-phone me-1"></i>Phone Number</label>
                            <p class="form-control-plaintext mb-0" id="viewPhone">
                                <a href="#" class="text-decoration-none" id="viewPhoneLink">-</a>
                            </p>
                        </div>
                        <!-- Address -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-map me-1"></i>Address</label>
                            <p class="form-control-plaintext mb-0" id="viewAddress">-</p>
                        </div>

                        <!-- ✅ Agent-Specific: Policy & Application Info -->
                        <hr class="my-3" />
                        <h6 class="mb-3 text-primary"><i class="bx bx-file me-1"></i>Application Information</h6>

                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-shield me-1"></i>Policy Name</label>
                            <p class="form-control-plaintext fw-medium mb-0" id="viewPolicyName">-</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Application Status</label>
                            <span id="viewAppStatusBadge" class="badge rounded-pill">-</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Application Date</label>
                            <p class="form-control-plaintext fw-medium mb-0" id="viewApplyDate">-</p>
                        </div>

                        <!-- Customer Account Status -->
                        <hr class="my-3" />
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-user-check me-1"></i>Account Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Registered Date</label>
                                <p class="form-control-plaintext fw-medium mb-0" id="viewCreatedAt">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer (Close Only - No Edit for Agent) -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (Same as Admin) ==================== -->
<style>
    .custom-card {
        border-radius: 20px;
        transition: transform 0.2s, box-shadow 0.2s;
        border: none;
        background: white;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        background: #eef2ff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .table > :not(caption) > * > * {
        padding: 1rem 0.75rem;
    }

    .page-link {
        border-radius: 30px !important;
        margin: 0 2px;
        color: #4b5563;
    }

    .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    /* View Modal Enhancements */
    #viewCustomerModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    #viewCustomerModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    @@media (max-width: 576px) {
        .btn-group {
            flex-direction: column;
            gap: 5px;
        }

            .btn-group .btn {
                width: 100%;
            }
    }
</style>

<!-- ==================== JAVASCRIPT ==================== -->
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        // ==================== SEARCH FUNCTIONALITY ====================
        const searchName = document.getElementById('searchName');
        const searchContact = document.getElementById('searchContact');

        function filterTable() {
        const nameVal = searchName.value.toLowerCase();
        const contactVal = searchContact.value.toLowerCase();

        document.querySelectorAll("#customersTable tbody tr").forEach(row => {
        const name = row.cells[1]?.textContent.toLowerCase() || '';
        const email = row.cells[2]?.textContent.toLowerCase() || '';
        const phone = row.cells[3]?.textContent.toLowerCase() || '';

        const matchesName = name.includes(nameVal);
        const matchesContact = email.includes(contactVal) || phone.includes(contactVal);

        row.style.display = (matchesName && matchesContact) ? "" : "none";
        });
        updatePaginationAfterFilter();
        }

        searchName.addEventListener("input", filterTable);
        searchContact.addEventListener("input", filterTable);


        // ==================== STATUS FILTER ====================
        document.querySelectorAll("[data-filter]").forEach(btn => {
        btn.addEventListener("click", function () {
        document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
        this.classList.add("active");

        const filter = this.getAttribute('data-filter');
        const rows = document.querySelectorAll("#customersTable tbody tr");

        rows.forEach(row => {
        const appStatus = row.getAttribute('data-app-status');

        if (filter === 'all' || filter === appStatus) {
        row.style.display = '';
        } else {
        row.style.display = 'none';
        }
        });
        updatePaginationAfterFilter();
        });
        });


        // ==================== PAGINATION ====================
        let currentPage = 1;
        const rowsPerPage = 10;

        function updatePaginationAfterFilter() {
        const visibleRows = Array.from(document.querySelectorAll("#customersTable tbody tr"))
        .filter(row => row.style.display !== "none");
        const pageCount = Math.ceil(visibleRows.length / rowsPerPage);
        currentPage = Math.min(currentPage, pageCount) || 1;
        displayTablePage(currentPage, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        }

        function displayTablePage(page, visibleRows) {
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        document.querySelectorAll("#customersTable tbody tr").forEach(row => {
        if (row.style.display === "none") return;
        const index = visibleRows.indexOf(row);
        row.style.display = (index >= start && index < end) ? "" : "none";
        });
        }

        function renderPaginationControls(pageCount, visibleRows) {
        const pagination = document.getElementById("pagination");
        pagination.innerHTML = "";
        if (pageCount <= 1) return;

        // Prev
        const prevLi = document.createElement("li");
        prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
        prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
        prevLi.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentPage > 1) { currentPage--; displayTablePage(currentPage, visibleRows); renderPaginationControls(pageCount, visibleRows); }
        });
        pagination.appendChild(prevLi);

        // Numbers
        for (let i = 1; i <= pageCount; i++) {
        const li = document.createElement("li");
        li.className = `page-item ${currentPage === i ? "active" : ""}`;
        li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
        li.addEventListener("click", (e) => {
        e.preventDefault(); currentPage = i; displayTablePage(currentPage, visibleRows); renderPaginationControls(pageCount, visibleRows);
        });
        pagination.appendChild(li);
        }

        // Next
        const nextLi = document.createElement("li");
        nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
        nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
        nextLi.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentPage < pageCount) { currentPage++; displayTablePage(currentPage, visibleRows); renderPaginationControls(pageCount, visibleRows); }
        });
        pagination.appendChild(nextLi);
        }

        // Initial pagination
        function initPagination() {
        const allRows = Array.from(document.querySelectorAll("#customersTable tbody tr"));
        const visibleRows = allRows.filter(row => row.style.display !== "none");
        const pageCount = Math.ceil(visibleRows.length / rowsPerPage);
        currentPage = 1;
        displayTablePage(1, visibleRows);
        renderPaginationControls(pageCount, visibleRows);
        }
        initPagination();


        // ==================== VIEW MODAL - Populate Data ====================
        const viewModal = document.getElementById('viewCustomerModal');

        viewModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;

        const customerId = button.getAttribute('data-customerid');
        const fullName = button.getAttribute('data-fullname');
        const email = button.getAttribute('data-email');
        const phone = button.getAttribute('data-phone');
        const address = button.getAttribute('data-address') || 'Not provided';
        const statusRaw = button.getAttribute('data-status');
        const status = (statusRaw === 'True' || statusRaw === 'true');
        const createdAt = button.getAttribute('data-createdat');

        // ✅ Agent-specific fields
        const policyName = button.getAttribute('data-policyname');
        const appStatus = button.getAttribute('data-appstatus');
        const applyDate = button.getAttribute('data-applydate');

        // Populate basic fields
        document.getElementById('viewCustomerIdDisplay').textContent = `#CUS-${customerId}`;
        document.getElementById('viewFullName').textContent = fullName || '-';

        // Email link
        const emailLink = document.getElementById('viewEmailLink');
        emailLink.textContent = email || '-';
        emailLink.href = email ? `mailto:${email}` : '#';

        // Phone link
        const phoneLink = document.getElementById('viewPhoneLink');
        phoneLink.textContent = phone || '-';
        phoneLink.href = phone ? `tel:${phone.replace(/\s+/g, '')}` : '#';

        // Address
        document.getElementById('viewAddress').textContent = address;

        // ✅ Policy & Application Info
        document.getElementById('viewPolicyName').textContent = policyName || '-';
        document.getElementById('viewApplyDate').textContent = applyDate || '-';

        // App Status Badge
        const appStatusBadge = document.getElementById('viewAppStatusBadge');
        const appStatusLower = appStatus?.toLowerCase();
        if (appStatusLower === 'approved') {
        appStatusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
        appStatusBadge.textContent = 'Approved';
        } else if (appStatusLower === 'rejected') {
        appStatusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
        appStatusBadge.textContent = 'Rejected';
        } else {
        appStatusBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
        appStatusBadge.textContent = 'Pending';
        }

        // Account Status Badge
        const statusBadge = document.getElementById('viewStatusBadge');
        if (status) {
        statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
        statusBadge.textContent = 'Active';
        } else {
        statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
        statusBadge.textContent = 'Inactive';
        }

        // Created Date
        document.getElementById('viewCreatedAt').textContent = createdAt || '-';
        });


        // ==================== EXPORT FUNCTIONS ====================
        window.exportTable = function (type, tableId, filename) {
        const table = document.getElementById(tableId);
        const rows = table.querySelectorAll('tbody tr');
        const data = [];

        // Header
        const headerRow = table.querySelector('thead tr');
        const headers = Array.from(headerRow.querySelectorAll('th')).map(th => th.innerText.trim());
        data.push(headers);

        // Data rows (only visible)
        for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        if (row.style.display === "none") continue;

        const rowData = [];
        const cols = row.querySelectorAll('td');
        for (let j = 0; j < cols.length - 1; j++) { // Exclude Actions column
        let text = cols[j].innerText.trim();
        if (j === 0 && text.startsWith('#CUS-')) text = text.replace('#CUS-', '');
        rowData.push(text);
        }
        data.push(rowData);
        }

        if (type === 'excel') {
        const ws = XLSX.utils.aoa_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Customers');
        XLSX.writeFile(wb, `${filename}.xlsx`);
        } else if (type === 'pdf') {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape' });
        doc.autoTable({
        head: [data[0]],
        body: data.slice(1),
        theme: 'striped',
        styles: { fontSize: 8, cellPadding: 2 },
        headStyles: { fillColor: [13, 110, 253] }
        });
        doc.save(`${filename}.pdf`);
        }
        };
        });
    </script>
}