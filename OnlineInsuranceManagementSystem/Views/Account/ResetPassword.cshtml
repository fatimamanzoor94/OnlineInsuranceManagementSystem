@model OnlineInsuranceManagementSystem.ViewModels.ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OIMS | Reset Password</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/Logo.png">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        primary: '#08979D',
        secondary: '#2F9D94',
        accent: '#025f67',
        success: '#23BBB7',
        background: '#F6F6F6',
        muted: '#36454f',
        deep: '#063154',
        border: '#bcc5cc',
        },
        fontFamily: {
        sans: ['Inter', 'sans-serif'],
        }
        }
        }
        }
    </script>

    <style>
        /* ========== ROOT VARIABLES ========== */
        :root {
        --primary: #08979D;
        --secondary: #2F9D94;
        --accent: #025f67;
        --success: #23BBB7;
        --background: #F6F6F6;
        --text-muted: #898F99;
        --deep: #063154;
        --border: #bcc5cc;
        }

        * {
        box-sizing: border-box;
        }

        /* Hero Section Background (same as Index.cshtml) */
        body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        position: relative;
        background-image: url('../images/Bg21.jfif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        }

        /* Dark overlay exactly like hero section */
        body::before {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(4, 31, 37, 0.89);
        z-index: 0;
        }

        /* All content above overlay */
        body > * {
        position: relative;
        z-index: 1;
        }

        /* Floating shapes (same as hero section) */
        .floating-shape {
        position: fixed;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
        z-index: 0;
        }

        /* Glassmorphism for navbar */
        .glass {
        background: rgba(246, 246, 246, 0.95);
        border: 1px solid var(--border);
        }

        /* Form Styles (unchanged from original) */
        .form-input {
        transition: all 0.3s ease;
        border: 2px solid var(--border);
        background-color: white;
        }

        .form-input:focus {
        border-color: var(--secondary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(8, 151, 157, 0.1);
        }

        .btn-primary {
        background-color: var(--primary);
        color: white;
        transition: all 0.3s ease;
        border: 2px solid var(--primary);
        }

        .btn-primary:hover {
        background-color: var(--accent);
        border-color: var(--accent);
        transform: translateY(-2px);
        }

        /* Tab Navigation - Glider Effect */
        .tab-nav-container {
        position: relative;
        display: flex;
        align-items: center;
        background: rgba(246, 246, 246, 0.9);
        border: 1px solid var(--border);
        border-radius: 9999px;
        padding: 0.25rem;
        gap: 0.25rem;
        }

        .tab-glider {
        position: absolute;
        top: 0.25rem;
        bottom: 0.25rem;
        background: var(--primary);
        border-radius: 9999px;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s ease;
        pointer-events: none;
        z-index: 0;
        }

        .tab-link {
        position: relative;
        z-index: 1;
        padding: 0.5rem 1rem;
        font-weight: 500;
        font-size: 0.875rem;
        color: var(--text-muted);
        border-radius: 9999px;
        transition: color 0.2s ease;
        text-decoration: none;
        white-space: nowrap;
        }

        .tab-link:hover {
        color: var(--primary);
        }

        .tab-link.active {
        color: white;
        }

        .tab-radio {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        }

        /* Hamburger Animation */
        .hamburger span {
        transition: all 0.3s ease;
        background-color: #4b5563;
        }

        .hamburger.active span:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
        }

        .hamburger.active span:nth-child(2) {
        opacity: 0;
        }

        .hamburger.active span:nth-child(3) {
        transform: rotate(-45deg) translate(7px, -6px);
        }

        /* Spinner */
        .spinner {
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top: 3px solid white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 1s linear infinite;
        }

        @@keyframes spin {
        0% {
        transform: rotate(0deg);
        }

        100% {
        transform: rotate(360deg);
        }
        }

        @@keyframes fadeInUp {
        from {
        opacity: 0;
        transform: translateY(40px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        .modal-content {
        animation: fadeInUp 0.5s ease;
        border: 1px solid var(--border);
        }

        /* Reset password card wrapper (centered below navbar) */
        .reset-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        }

        @@media (min-width: 1024px) {
        .reset-wrapper {
        min-height: calc(100vh - 96px);
        }
        }
    </style>
</head>

<body>

    <!-- Floating Shapes (same as hero section) -->
    <div class="floating-shape" style="top: 10%; left: 5%; width: 80px; height: 80px; animation: float 3s ease-in-out infinite;"></div>
    <div class="floating-shape" style="bottom: 15%; right: 8%; width: 120px; height: 120px; animation: float 4s ease-in-out infinite 1s;"></div>
    <div class="floating-shape" style="top: 20%; right: 15%; width: 60px; height: 60px; animation: float 3.5s ease-in-out infinite 0.5s;"></div>
    <div class="floating-shape" style="bottom: 30%; left: 10%; width: 40px; height: 40px; animation: float 2.8s ease-in-out infinite 1.5s;"></div>

    <style>
        @@keyframes float {
        0%, 100% {
        transform: translateY(0px);
        }

        50% {
        transform: translateY(-15px);
        }
        }
    </style>

    

    <!-- ========== RESET PASSWORD FORM (COMPLETELY UNCHANGED) ========== -->
    <div class="reset-wrapper">
        <div class="w-full max-w-md bg-white rounded-3xl overflow-hidden modal-content mx-auto shadow-2xl">
            <!-- Header -->
            <div class="bg-primary p-6 text-white text-center relative">
                <a href="/Account/Login"
                   class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/30 transition-colors"
                   aria-label="Close">
                    <i class="fas fa-times"></i>
                </a>
                <div class="w-11 h-11 sm:w-12 sm:h-12 mx-auto rounded-full bg-white/20 flex items-center justify-center mb-3">
                    <i class="fas fa-lock-open text-lg"></i>
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold mobile-title">Reset Password</h2>
                <p class="text-white/70 text-sm mt-1">Create a new secure password</p>
            </div>

            <!-- Form Section -->
            <div class="p-5 sm:p-6 mobile-padding">
                @if (TempData["Error"] != null)
                {
                    <div class="bg-red-100 border border-red-200 text-red-700 p-3 rounded-xl mb-5 text-sm">
                        @TempData["Error"]
                    </div>
                }

                <form method="post" id="resetPasswordForm" class="space-y-5">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <!-- Email Display (Read-only) -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Email Address
                        </label>
                        <div class="relative">
                            <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                            <input type="email"
                                   value="@Model.Email"
                                   readonly
                                   class="form-input text-sm w-full pl-11 pr-4 py-2.5 rounded-lg bg-gray-50 cursor-not-allowed" />
                        </div>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            New Password
                        </label>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                            <input asp-for="NewPassword"
                                   type="password"
                                   id="newPassword"
                                   placeholder="••••••••"
                                   class="form-input text-sm w-full pl-11 pr-12 py-2.5 rounded-lg focus:outline-none" />
                            <button type="button"
                                    onclick="togglePassword('newPassword', 'eyeIcon1')"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-primary transition-colors">
                                <i id="eyeIcon1" class="fas fa-eye"></i>
                            </button>
                        </div>

                        <!-- Password Strength -->
                        <div class="mt-2">
                            <div class="w-full bg-gray-200 rounded-full h-1.5">
                                <div id="strengthBar" class="h-1.5 rounded-full transition-all duration-300"></div>
                            </div>
                            <p id="strengthText" class="text-xs mt-1 text-gray-500"></p>
                        </div>

                        <span asp-validation-for="NewPassword" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Confirm New Password
                        </label>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPassword"
                                   placeholder="••••••••"
                                   class="form-input text-sm w-full pl-11 pr-12 py-2.5 rounded-lg focus:outline-none" />
                            <button type="button"
                                    onclick="togglePassword('confirmPassword', 'eyeIcon2')"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-primary transition-colors">
                                <i id="eyeIcon2" class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <!-- Security Note -->
                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
                        <i class="fas fa-shield-alt mr-2"></i>
                        Password must contain: uppercase, lowercase, number &amp; special character (!@@#$%^&amp;*)
                    </div>

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 border border-red-200 p-3 rounded-xl"></div>

                    <!-- Submit Button -->
                    <button type="submit"
                            id="submitBtn"
                            class="w-full btn-primary py-2.5 rounded-lg text-white font-semibold text-sm sm:text-base flex items-center justify-center">
                        <span id="btnText">Reset Password</span>
                        <div id="spinner" class="spinner hidden ml-2"></div>
                    </button>
                </form>

                <!-- Back to Login -->
                <p class="text-center text-muted text-sm mt-6">
                    <a href="/Account/Login" class="text-primary font-semibold hover:underline">
                        ← Back to Login
                    </a>
                </p>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Toggle Password Visibility (unchanged from original)
        function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
        } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
        }
        }

        // Password Strength Meter (unchanged from original)
        document.getElementById("newPassword").addEventListener("keyup", function () {
        let password = this.value;
        let strength = 0;
        if (password.length >= 8) strength++;
        if (/[A-Z]/.test(password)) strength++;
        if (/[a-z]/.test(password)) strength++;
        if (/[0-9]/.test(password)) strength++;
        if (/[^A-Za-z0-9]/.test(password)) strength++;

        let bar = document.getElementById("strengthBar");
        let text = document.getElementById("strengthText");

        if (strength <= 2) {
        bar.style.width = "30%";
        bar.style.background = "#ef4444";
        text.innerHTML = "<span class='text-red-600'>Weak</span> - Add more complexity";
        } else if (strength <= 4) {
        bar.style.width = "70%";
        bar.style.background = "#f59e0b";
        text.innerHTML = "<span class='text-amber-600'>Medium</span> - Almost there";
        } else {
        bar.style.width = "100%";
        bar.style.background = "#22c55e";
        text.innerHTML = "<span class='text-green-600'>Strong</span> ✓";
        }
        });

        // Form Submit Animation (unchanged)
        document.getElementById("resetPasswordForm").addEventListener("submit", function () {
        document.getElementById("btnText").innerText = "Resetting...";
        document.getElementById("spinner").classList.remove("hidden");
        this.querySelector('button[type="submit"]').disabled = true;
        });

        // ========== NAVBAR FUNCTIONALITY (from Index.cshtml) ==========
        const tabLinks = document.querySelectorAll('.tab-link');
        const tabRadios = document.querySelectorAll('.tab-radio');
        const glider = document.getElementById('tabGlider');

        function updateGlider(activeTab) {
        if (!glider || !activeTab) return;
        const parentRect = activeTab.parentElement.getBoundingClientRect();
        const tabRect = activeTab.getBoundingClientRect();
        const left = tabRect.left - parentRect.left;
        glider.style.transform = `translateX(${left}px)`;
        glider.style.width = `${tabRect.width}px`;
        }

        function setActiveTab(index) {
        tabLinks.forEach((link, i) => {
        if (i == index) {
        link.classList.add('active');
        link.setAttribute('aria-selected', 'true');
        updateGlider(link);
        } else {
        link.classList.remove('active');
        link.setAttribute('aria-selected', 'false');
        }
        });
        if (tabRadios[index]) tabRadios[index].checked = true;
        }

        tabLinks.forEach((link, index) => {
        link.addEventListener('click', (e) => {
        e.preventDefault();
        setActiveTab(index);
        const targetId = link.getAttribute('href');
        if (targetId && targetId !== '#') {
        window.location.href = targetId;
        }
        });
        });

        // Initialize glider on load
        document.addEventListener('DOMContentLoaded', function() {
        const activeTab = document.querySelector('.tab-link.active');
        if (activeTab) updateGlider(activeTab);
        else if (tabLinks.length) updateGlider(tabLinks[0]);
        });

        // Hamburger menu toggle
        const hamburger = document.getElementById('hamburger');
        const mobileMenu = document.getElementById('mobileMenu');
        if (hamburger && mobileMenu) {
        hamburger.addEventListener('click', function() {
        this.classList.toggle('active');
        mobileMenu.classList.toggle('hidden');
        const expanded = mobileMenu.classList.contains('hidden') ? 'false' : 'true';
        hamburger.setAttribute('aria-expanded', expanded);
        });
        }
    </script>
</body>
</html>