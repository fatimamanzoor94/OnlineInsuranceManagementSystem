@model OnlineInsuranceManagementSystem.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>OIMS | Login</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/Logo.png">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">

    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        primary: '#08979D',
        secondary: '#2F9D94',
        accent: '#025f67',
        success: '#23BBB7',
        background: '#F6F6F6',
        muted: '#36454f',
        deep: '#063154',
        border: '#bcc5cc',
        },
        fontFamily: {
        sans: ['Inter', 'sans-serif'],
        }
        }
        }
        }
    </script>

    <style>
        :root {
        --primary: #08979D;
        --secondary: #2F9D94;
        --accent: #025f67;
        --success: #23BBB7;
        --background: #F6F6F6;
        --text-muted: #898F99;
        --deep: #063154;
        --border: #bcc5cc;
        }

        * {
        box-sizing: border-box;
        }

        body {
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem;
        margin: 0;
        position: relative;
        background-image: url('../images/Bg21.jfif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        }

        body::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(4, 31, 37, 0.89);
        z-index: 0;
        }

        body > * {
        position: relative;
        z-index: 1;
        }

        .floating-shape {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
        z-index: 0;
        }

        .form-input {
        transition: all 0.3s ease;
        border: 2px solid var(--border);
        background-color: white;
        }

        .form-input:focus {
        border-color: var(--secondary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(8, 151, 157, 0.1);
        }

        .btn-primary {
        background-color: var(--primary);
        color: white;
        transition: all 0.3s ease;
        border: 2px solid var(--primary);
        }

        .btn-primary:hover {
        background-color: var(--accent);
        border-color: var(--accent);
        transform: translateY(-2px);
        }

        @@keyframes spin {
        0% {
        transform: rotate(0deg);
        }

        100% {
        transform: rotate(360deg);
        }
        }

        .spinner {
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top: 3px solid white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 1s linear infinite;
        }

        @@keyframes fadeInUp {
        from {
        opacity: 0;
        transform: translateY(40px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        .modal-content {
        animation: fadeInUp 0.5s ease;
        border: 1px solid var(--border);
        }

        input::-ms-reveal,
        input::-ms-clear {
        display: none;
        }

        @@media (max-width: 480px) {
        .mobile-padding {
        padding: 1.25rem;
        }

        .mobile-title {
        font-size: 1.5rem;
        }
        }
    </style>

</head>

<body>

    <!-- Floating shapes  -->
    <div class="floating-shape" style="top: 10%; left: 5%; width: 80px; height: 80px; animation: float 3s ease-in-out infinite;"></div>
    <div class="floating-shape" style="bottom: 15%; right: 8%; width: 120px; height: 120px; animation: float 4s ease-in-out infinite 1s;"></div>
    <div class="floating-shape" style="top: 20%; right: 15%; width: 60px; height: 60px; animation: float 3.5s ease-in-out infinite 0.5s;"></div>
    <div class="floating-shape" style="bottom: 30%; left: 10%; width: 40px; height: 40px; animation: float 2.8s ease-in-out infinite 1.5s;"></div>

    <style>
        @@keyframes float {
        0%, 100% {
        transform: translateY(0px);
        }

        50% {
        transform: translateY(-15px);
        }
        }
    </style>

    <div class="w-full max-w-md bg-white rounded-3xl overflow-hidden modal-content mx-auto shadow-2xl">

        <!-- Header -->
        <div class="bg-primary p-6 text-white text-center relative">

            <a href="/"
               class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/30 transition-colors"
               aria-label="Close">

                <i class="fas fa-times"></i>

            </a>

            <div class="w-11 h-11 sm:w-12 sm:h-12 mx-auto rounded-full bg-white/20 flex items-center justify-center mb-3">
                <i class="fas fa-user-lock text-lg"></i>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold mobile-title">
                Welcome Back
            </h2>

            <p class="text-white/70 text-sm mt-1">
                Sign in to your account
            </p>

        </div>

        <!-- Form Section -->
        <div class="p-5 sm:p-6 mobile-padding">

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-100 border border-green-200 text-green-700 p-3 rounded-xl mb-5 text-sm">
                    @TempData["Success"]
                </div>
            }

            @if (ViewBag.Message != null)
            {
                <div class="bg-red-100 border border-red-200 text-red-700 p-3 rounded-xl mb-5 text-sm">
                    @ViewBag.Message
                </div>
            }

            <form method="post" id="loginForm" class="space-y-5">

                <!-- Email -->
                <div>

                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Email Address
                    </label>

                    <div class="relative">

                        <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>

                        <input asp-for="Email"
                               type="email"
                               placeholder="you@example.com"
                               class="form-input text-sm w-full pl-11 pr-4 py-2.5 rounded-lg focus:outline-none" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-red-500 text-sm mt-1 block"></span>

                </div>

                <!-- Password -->
                <div>

                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Password
                    </label>

                    <div class="relative">

                        <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>

                        <input asp-for="Password"
                               id="loginPassword"
                               type="password"
                               placeholder="••••••••"
                               class="form-input text-sm w-full pl-11 pr-12 py-2.5 rounded-lg focus:outline-none" />

                        <button type="button"
                                onclick="toggleLoginPassword()"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-primary transition-colors">

                            <i id="passwordIcon" class="fas fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-red-500 text-sm mt-1 block"></span>

                </div>

                <!-- Remember Me + Forgot Section -->
                <div class="flex items-center justify-between flex-wrap gap-2">

                    <!-- Left Side -->
                    <div class="flex items-center space-x-2">

                        <label class="flex items-center space-x-2 cursor-pointer">

                            <input asp-for="RememberMe"
                                   type="checkbox"
                                   class="w-4 h-4 rounded accent-primary">

                            <span class="text-sm text-gray-600">
                                Remember me
                            </span>

                        </label>

                        <span asp-validation-for="RememberMe"
                              class="text-red-500 text-xs"></span>

                    </div>

                    <!-- Right Side -->
                    <a href="/Account/ForgotPassword"
                       class="text-sm text-primary hover:underline font-medium transition-colors">
                        Forgot Password?
                    </a>

                </div>

                <!-- Login Button -->
                <button type="submit"
                        id="loginBtn"
                        class="w-full btn-primary py-2.5 rounded-lg text-white font-semibold text-sm sm:text-base flex items-center justify-center">

                    <span id="loginBtnText">
                        Login
                    </span>

                    <div id="loginSpinner"
                         class="spinner hidden ml-2"></div>

                </button>

            </form>

            <!-- Register -->
            <p class="text-center text-muted text-sm mt-6">

                Don't have an account?

                <a href="/Account/RegisterChoice"
                   class="text-primary font-semibold hover:underline">

                    Register Now

                </a>

            </p>

            <!-- Back -->
            <p class="text-center text-gray-500 text-xs mt-4">

                <a href="/"
                   class="hover:text-primary transition-colors">

                    ← Back to Home

                </a>

            </p>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener('DOMContentLoaded', function() {
        const rememberMeError = document.querySelector('[data-valmsg-for="RememberMe"]');
        if (rememberMeError) {
        rememberMeError.innerHTML = '';
        }
        });

        function toggleLoginPassword() {

        const password = document.getElementById("loginPassword");
        const icon = document.getElementById("passwordIcon");

        if (password.type === "password") {
        password.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
        } else {
        password.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
        }
        }

        document.getElementById("loginForm").addEventListener("submit", function () {
        document.getElementById("loginBtnText").innerText = "Signing In...";
        document.getElementById("loginSpinner").classList.remove("hidden");
        });

    </script>

</body>
</html>