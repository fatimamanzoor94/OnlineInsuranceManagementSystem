<script>
    const toggleBtn = document.getElementById("themeToggle");
    const icon = document.getElementById("themeIcon");
    if (toggleBtn) {
        toggleBtn.addEventListener("click", function () {
            document.body.classList.toggle("dark-mode");
            if (document.body.classList.contains("dark-mode")) {
                icon.classList.remove("bx-moon");
                icon.classList.add("bx-sun");
            } else {
                icon.classList.remove("bx-sun");
                icon.classList.add("bx-moon");
            }
        });
    }
</script>
@await RenderSectionAsync("Scripts", required: false)

    <script>
    window.exportTable = function (type, tableId, fileName) {

        const table = document.getElementById(tableId);

        if (!table) {
            alert("Table not found!");
            return;
        }

        const today = new Date().toLocaleDateString();

        // =========================
        // GET TABLE HEADERS
        // =========================
        const headers = [];

        table.querySelectorAll("thead th").forEach((th) => {

            // Skip Actions column
            if (th.innerText.trim().toLowerCase() !== "actions") {
                headers.push(th.innerText.trim());
            }
        });

        // =========================
        // GET TABLE ROWS
        // =========================
        const rows = [];

        table.querySelectorAll("tbody tr").forEach(row => {

            // Skip hidden rows
            if (row.style.display === "none") return;

            const rowData = [];

            Array.from(row.cells).forEach((cell, index) => {

                const headerText = table.querySelectorAll("thead th")[index]
                    ?.innerText
                    ?.trim()
                    ?.toLowerCase();

                // Skip Actions column
                if (headerText !== "actions") {

                    rowData.push(
                        cell.innerText.trim()
                    );
                }
            });

            rows.push(rowData);
        });

        // =========================
        // EXCEL EXPORT
        // =========================
        if (type === "excel") {

            const wb = XLSX.utils.book_new();

            const data = [
                headers,
                ...rows
            ];

            const ws = XLSX.utils.aoa_to_sheet(data);

            // Auto width
            ws['!cols'] = headers.map((header, i) => {

                let maxLength = header.length;

                rows.forEach(r => {

                    const cellValue = r[i]
                        ? r[i].toString()
                        : "";

                    if (cellValue.length > maxLength) {
                        maxLength = cellValue.length;
                    }
                });

                return {
                    wch: Math.min(maxLength + 8, 80)
                };
            });

            XLSX.utils.book_append_sheet(
                wb,
                ws,
                fileName
            );

            XLSX.writeFile(
                wb,
                fileName + ".xlsx"
            );
        }

        // =========================
        // PDF EXPORT
        // =========================
        if (type === "pdf") {

            const { jsPDF } = window.jspdf;

            const doc = new jsPDF("landscape");

            // Company Name
            doc.setFontSize(18);
            doc.setTextColor(8, 145, 178);
            doc.text(
                "Online Insurance Management System",
                14,
                15
            );

            // Report Name
            doc.setFontSize(13);
            doc.setTextColor(0, 0, 0);
            doc.text(
                fileName + " Report",
                14,
                25
            );

            // Date
            doc.setFontSize(10);
            doc.text(
                "Generated On: " + today,
                14,
                32
            );

            // Dynamic column widths
            const columnStyles = {};

            headers.forEach((h, i) => {

                // Description column wider
                if (h.toLowerCase().includes("description")) {

                    columnStyles[i] = {
                        cellWidth: 80
                    };
                }
                else {

                    columnStyles[i] = {
                        cellWidth: "auto"
                    };
                }
            });

            doc.autoTable({

                startY: 40,

                head: [headers],

                body: rows,

                theme: "grid",

                styles: {
                    fontSize: 9,
                    cellPadding: 4,
                    valign: "middle",
                    overflow: "linebreak"
                },

                headStyles: {
                    fillColor: [13, 110, 253],
                    textColor: [255, 255, 255],
                    fontStyle: "bold"
                },

                alternateRowStyles: {
                    fillColor: [245, 247, 250]
                },

                columnStyles: columnStyles
            });

            doc.save(fileName + ".pdf");
        }
    };


        document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("globalSearch");

        if (!searchInput) return;

        // Mapping of keywords → pages
        const routes = {
        "dashboard": "/Admin/Dashboard",
        "home": "/Admin/Dashboard",

        "applications": "/Admin/Applications",
        "application": "/Admin/Applications",

        "claims": "/Admin/Claims",
        "claim": "/Admin/Claims",

        "policies": "/InsuranceManagement/Policies",
        "policy": "/InsuranceManagement/Policies",

        "customers": "/UserManagement/Customers",
        "customer": "/UserManagement/Customers",

        "agents": "/UserManagement/Agents",
        "agent": "/UserManagement/Agents",

        "payments": "/Admin/Payments",
        "payment": "/Admin/Payments",

        "loans": "/Admin/Loans",
        "loan": "/Admin/Loans",

        "messages": "/Admin/Messages",
        "message": "/Admin/Messages",

        "reports": "/Admin/Reports",
        "report": "/Admin/Reports"
        };

        searchInput.addEventListener("keydown", function (e) {

        if (e.key === "Enter") {

        const query = searchInput.value.trim().toLowerCase();

        if (query === "") return;

        // match search text
        let match = null;

        for (const key in routes) {
        if (key.includes(query)) {
        match = routes[key];
        break;
        }
        }

        if (match) {
        window.location.href = match;
        }
        else {
        alert("No page found for: " + query);
        }
        }
        });

        });

    </script>

