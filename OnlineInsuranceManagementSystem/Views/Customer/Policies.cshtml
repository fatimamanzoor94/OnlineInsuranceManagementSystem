@model OnlineInsuranceManagementSystem.ViewModels.CustomerPoliciesIndexViewModel
@{
    ViewData["Title"] = "Available Policies";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Available Policies</h4>
                <div class="d-flex gap-2">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                        <i class="bx bx-list-ul me-1"></i> @Model.TotalAvailablePolicies Available
                    </span>
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                        <i class="bx bx-check-circle me-1"></i> @Model.ApprovedApplications Approved
                    </span>
                </div>
            </div>

            <!-- Search & Filter -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Policy Name</label>
                            <input type="text" id="searchPolicyName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter policy name..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Filter by Insurance Type</label>
                            <select id="searchInsuranceType" class="form-control form-control-sm rounded-pill px-3">
                                <option value="">All Types</option>
                                @foreach (var type in Model.InsuranceTypes)
                                {
                                    <option value="@type.Name">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">My Applications</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill active" data-filter="all">All</button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill" data-filter="not-applied">Not Applied</button>
                                <button class="btn btn-sm btn-outline-warning rounded-pill" data-filter="pending">Pending</button>
                                <button class="btn btn-sm btn-outline-success rounded-pill" data-filter="approved">Approved</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">Insurance Policies</h4>
                            <small class="text-muted">Browse and apply for available policies</small>
                        </div>
                        <!-- Export Buttons -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'policiesTable', 'AvailablePolicies')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'policiesTable', 'AvailablePolicies')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="policiesTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Policy ID</th>
                                    <th>Policy Name</th>
                                    <th>Insurance Type</th>
                                    <th>Premium Amount</th>
                                    <th>Duration</th>
                                    <th>Coverage Amount</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var policy in Model.Policies)
                                {
                                    <tr>
                                        <td>@policy.PolicyIdFormatted</td>
                                        <td>@policy.PolicyName</td>
                                        <td>@policy.InsuranceTypeName</td>
                                        <td>$@policy.PremiumFormatted</td>
                                        <td>@policy.DurationFormatted</td>
                                        <td>$@policy.CoverageFormatted</td>
                                        <td>
                                            @if (policy.Status)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>@policy.CreatedAtFormatted</td>
                                        <td>
    <div class="btn-group btn-group-sm d-flex gap-2">
        <!-- VIEW DETAILS BUTTON -->
        <button class="btn btn-outline-info view-btn"
                data-bs-toggle="modal"
                data-bs-target="#viewPolicyModal"
                data-policyid="@policy.PolicyId"
                data-policyname="@policy.PolicyName"
                data-insurancetypename="@policy.InsuranceTypeName"
                data-premiumamount="@policy.PremiumFormatted"
                data-duration="@policy.Duration"
                data-coverageamount="@policy.CoverageFormatted"
                data-terms="@policy.Terms"
                data-status="@policy.Status"
                data-createdat="@policy.CreatedAtFormatted"
                title="View Details">
            View
        </button>

        <!-- ✅ APPLY NOW BUTTON - Must have data-policyid -->
                                                @if (policy.HasApplied)
                                                {
                                                    <button class="btn btn-outline-success applied-btn" disabled title="Already Applied">
                                                        <i class="bx bx-check me-1"></i>Applied
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-primary apply-btn"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#applyPolicyModal"
                                                            data-policyid="@policy.PolicyId"
                                                            data-policyname="@policy.PolicyName"
                                                            data-premiumamount="@policy.PremiumFormatted"
                                                            title="Apply Now">
                                                        Apply Now
                                                    </button>
                                                }

        <!-- Application Status Badge -->
        @if (policy.HasApplied)
        {
            <span class="badge @(
                policy.ApplicationStatus == "Pending" ? "bg-warning-subtle text-warning" :
                policy.ApplicationStatus == "Approved" ? "bg-success-subtle text-success" :
                "bg-danger-subtle text-danger"
            ) rounded-pill">
                @policy.ApplicationStatus
            </span>
        }
    </div>
</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Policies: @Model.Policies.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== APPLY POLICY MODAL ==================== -->
<div class="modal fade" id="applyPolicyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Apply for Policy</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <!-- ✅ IMPORTANT: Form with proper structure -->
                <form id="applyPolicyForm">
                    @Html.AntiForgeryToken()

                    <!-- ✅ Hidden field for PolicyId - MUST have name="PolicyId" for model binding -->
                    <input type="hidden" id="applyPolicyId" name="PolicyId" />

                    <div class="alert alert-info rounded-3 mb-3">
                        <i class="bx bx-info-circle me-2"></i>
                        <strong id="applyPolicyNameDisplay"></strong><br />
                        <small>Premium: $<span id="applyPremiumDisplay"></span></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Application Date</label>
                        <input type="text" class="form-control form-control-sm rounded-pill px-3"
                               value="@DateTime.Now.ToString("dd-MMM-yyyy")" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Status</label>
                        <input type="text" class="form-control form-control-sm rounded-pill px-3 bg-light"
                               value="Pending" disabled />
                    </div>

                    <div class="alert alert-warning rounded-3 small">
                        <i class="bx bx-error-circle me-1"></i>
                        By applying, you agree to the policy terms and conditions.
                        Your application will be reviewed by our team.
                    </div>

                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitApplyBtn">
                            <i class="bx bx-paper-plane me-1"></i> Submit Application
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW POLICY DETAILS MODAL (Same as Admin, Read-Only) ==================== -->
<div class="modal fade" id="viewPolicyModal" tabindex="-1" aria-labelledby="viewPolicyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-shield-quarter text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewPolicyModalLabel">Policy Details</h5>
                        <small class="text-muted" id="viewPolicyIdDisplay">#POL-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Policy Name -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-tag me-1"></i>Policy Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewPolicyName">-</p>
                        </div>

                        <!-- Insurance Type -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-category me-1"></i>Insurance Type</label>
                            <p class="form-control-plaintext mb-0" id="viewInsuranceType">-</p>
                        </div>

                        <!-- Premium & Coverage -->
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-dollar me-1"></i>Premium Amount</label>
                                <p class="form-control-plaintext fw-semibold mb-0" id="viewPremiumAmount">-</p>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-wallet me-1"></i>Coverage Amount</label>
                                <p class="form-control-plaintext fw-semibold mb-0" id="viewCoverageAmount">-</p>
                            </div>
                        </div>

                        <!-- Duration -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-time me-1"></i>Duration</label>
                            <p class="form-control-plaintext mb-0" id="viewDuration">-</p>
                        </div>

                        <!-- Terms -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-file me-1"></i>Terms & Conditions</label>
                            <p class="form-control-plaintext mb-0" id="viewTerms" style="white-space: pre-wrap; max-height: 120px; overflow-y: auto;">-</p>
                        </div>

                        <!-- Status & Created Date -->
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Created Date</label>
                                <p class="form-control-plaintext fw-medium mb-0" id="viewCreatedAt">-</p>
                            </div>
                        </div>

                        <!-- Application Status (if already applied) -->
                        <div id="applicationStatusSection" class="mt-3 pt-3 border-top d-none">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-time-five me-1"></i>My Application</label>
                            <div class="d-flex align-items-center gap-2">
                                <span id="myApplicationStatus" class="badge rounded-pill">-</span>
                                <small class="text-muted" id="myAppliedDate"></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="viewApplyPolicyBtn">
                    Apply for This Policy
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (IDENTICAL TO ADMIN) ==================== -->
<style>
    /* Delete Modal Animation - KEPT FOR CONSISTENCY (unused but preserved) */
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        background: #ffffff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icon-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icon-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* View Modal Enhancements */
    #viewPolicyModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewPolicyModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    #viewPolicyModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        #viewPolicyModal .card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    #viewPolicyModal #viewTerms {
        font-size: 0.95rem;
        line-height: 1.5;
    }

    @@media (max-width: 576px) {
        #viewPolicyModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewPolicyModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT (IDENTICAL STRUCTURE, MODIFIED LOGIC) ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==================== SEARCH FUNCTIONALITY (IDENTICAL) ====================
            const searchPolicyName = document.getElementById('searchPolicyName');
            const searchInsuranceType = document.getElementById('searchInsuranceType');

            function filterTable() {
                const nameVal = searchPolicyName.value.toLowerCase();
                const typeVal = searchInsuranceType.value;

                document.querySelectorAll("#policiesTable tbody tr").forEach(row => {
                    const name = row.cells[1]?.textContent.toLowerCase() || '';
                    const type = row.cells[2]?.textContent.toLowerCase() || '';

                    const nameMatch = name.includes(nameVal);
                    const typeMatch = typeVal === "" || type.includes(typeVal.toLowerCase());

                    row.style.display = (nameMatch && typeMatch) ? "" : "none";
                });
            }

            searchPolicyName.addEventListener("input", filterTable);
            searchInsuranceType.addEventListener("change", filterTable);


            // ==================== PAGINATION (IDENTICAL) ====================
            const rowsPerPage = 10;
            const tableRows = document.querySelectorAll("#policiesTable tbody tr");
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function displayTablePage(page) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                tableRows.forEach((row, index) => {
                    if (row.style.display === "none") {
                        row.dataset.hiddenByFilter = "true";
                    } else {
                        row.dataset.hiddenByFilter = "false";
                    }

                    const isVisible = row.dataset.hiddenByFilter !== "true";
                    const isInPage = index >= start && index < end;

                    row.style.display = (isVisible && isInPage) ? "" : "none";
                });
                updatePaginationButtons();
            }

            function updatePaginationButtons() {
                const visibleRows = Array.from(tableRows).filter(row => row.dataset.hiddenByFilter !== "true");
                const pageCount = Math.ceil(visibleRows.length / rowsPerPage) || 1;

                if (currentPage > pageCount) currentPage = 1;

                pagination.innerHTML = "";

                // Prev Button
                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prevLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage > 1) displayTablePage(currentPage - 1);
                });
                pagination.appendChild(prevLi);

                // Page Numbers
                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(pageCount, startPage + 4);

                if (endPage - startPage < 4 && pageCount > 5) {
                    startPage = Math.max(1, endPage - 4);
                }

                for (let i = startPage; i <= endPage; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${currentPage === i ? "active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", function (e) {
                        e.preventDefault();
                        displayTablePage(i);
                    });
                    pagination.appendChild(li);
                }

                // Next Button
                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                nextLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage < pageCount) displayTablePage(currentPage + 1);
                });
                pagination.appendChild(nextLi);
            }

            displayTablePage(1);

            const originalFilterTable = filterTable;
            filterTable = function() {
                originalFilterTable();
                currentPage = 1;
                displayTablePage(1);
            };


            // ==================== APPLICATION STATUS FILTER (CUSTOMER-SPECIFIC) ====================
            document.querySelectorAll("[data-filter]").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    const filter = this.getAttribute('data-filter');
                    const rows = document.querySelectorAll("#policiesTable tbody tr");

                    rows.forEach(row => {
                        const appliedBtn = row.querySelector('.applied-btn');
                        const applyBtn = row.querySelector('.apply-btn');
                        const statusBadge = row.querySelector('span.badge.rounded-pill');

                        let showRow = false;

                        if (filter === 'all') {
                            showRow = true;
                        } else if (filter === 'not-applied' && applyBtn && !applyBtn.disabled) {
                            showRow = true;
                        } else if (filter === 'pending' && statusBadge && statusBadge.classList.contains('bg-warning-subtle')) {
                            showRow = true;
                        } else if (filter === 'approved' && statusBadge && statusBadge.classList.contains('bg-success-subtle')) {
                            showRow = true;
                        }

                        // Also respect search filters
                        const nameVal = searchPolicyName.value.toLowerCase();
                        const typeVal = searchInsuranceType.value;
                        const name = row.cells[1]?.textContent.toLowerCase() || '';
                        const type = row.cells[2]?.textContent.toLowerCase() || '';
                        const nameMatch = name.includes(nameVal);
                        const typeMatch = typeVal === "" || type.includes(typeVal.toLowerCase());

                        if (showRow && nameMatch && typeMatch) {
                            row.style.display = '';
                            row.dataset.hiddenByFilter = 'false';
                        } else {
                            row.style.display = 'none';
                            row.dataset.hiddenByFilter = 'true';
                        }
                    });

                    currentPage = 1;
                    displayTablePage(1);
                });
            });


                    // ==================== APPLY MODAL - Populate Data ====================
        const applyModal = document.getElementById('applyPolicyModal');
        applyModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            // ✅ Extract data from button's data-* attributes
            const policyId = button.getAttribute('data-policyid');
            const policyName = button.getAttribute('data-policyname');
            const premiumAmount = button.getAttribute('data-premiumamount');

            // 🎯 DEBUG: Log what we received
            console.log('[ApplyModal] Opening for Policy:', { policyId, policyName, premiumAmount });

            // ✅ Populate hidden field (MUST match ViewModel property name)
            document.getElementById('applyPolicyId').value = policyId;

            // Populate display fields
            document.getElementById('applyPolicyNameDisplay').textContent = policyName || 'Unknown Policy';
            document.getElementById('applyPremiumDisplay').textContent = premiumAmount || '0.00';
        });


            // ==================== APPLY FORM SUBMISSION (AJAX) ====================
                    // ==================== APPLY FORM SUBMISSION (FIXED) ====================
        document.getElementById('applyPolicyForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submitApplyBtn');
            const originalBtnText = submitBtn.innerHTML;

            // Disable button to prevent double-submit
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> Submitting...';

            try {
                // 🔑 Get CSRF token
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const policyId = document.getElementById('applyPolicyId')?.value;

                // 🎯 DEBUG: Log what we're sending
                console.log('[ApplyForm] Submitting:', { policyId, csrfToken: csrfToken ? 'present' : 'missing' });

                if (!policyId || !csrfToken) {
                    throw new Error('Missing required form data');
                }

                // ✅ FIXED: Send as FORM DATA (not JSON) for proper model binding
                const formData = new FormData();
                formData.append('PolicyId', policyId);
                formData.append('__RequestVerificationToken', csrfToken);

                const response = await fetch('/Customer/ApplyPolicy', {
                    method: 'POST',
                    // 🚫 Don't set Content-Type - browser sets it automatically for FormData
                    body: formData
                });

                const result = await response.json();
                console.log('[ApplyForm] Response:', result);

                if (result.success) {
                    // ✅ Show success toast
                    showAlert('success', result.message);

                    // Close modal
                    const modalInstance = bootstrap.Modal.getInstance(document.getElementById('applyPolicyModal'));
                    modalInstance.hide();

                    // Refresh page to update UI after 1 second
                    setTimeout(() => location.reload(), 1000);
                } else {
                    // ❌ Show error
                    showAlert('danger', result.message || 'Application failed. Please try again.');
                }
            } catch (error) {
                console.error('[ApplyForm] Error:', error);
                showAlert('danger', 'Network error. Please check your connection.');
            } finally {
                // Re-enable button
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
            }
        });


            // ==================== VIEW MODAL - Populate Data (ENHANCED) ====================
            const viewModal = document.getElementById('viewPolicyModal');

            viewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                const policyId = button.getAttribute('data-policyid');
                const policyName = button.getAttribute('data-policyname');
                const insuranceTypeName = button.getAttribute('data-insurancetypename');
                const premiumAmount = button.getAttribute('data-premiumamount');
                const duration = button.getAttribute('data-duration');
                const coverageAmount = button.getAttribute('data-coverageamount');
                const terms = button.getAttribute('data-terms') || 'No terms specified';
                const statusRaw = button.getAttribute('data-status');
                const status = (statusRaw === 'True' || statusRaw === 'true' || statusRaw === '1');
                const createdAt = button.getAttribute('data-createdat');

                // Populate fields
                document.getElementById('viewPolicyIdDisplay').textContent = `#POL-${policyId}`;
                document.getElementById('viewPolicyName').textContent = policyName || '-';
                document.getElementById('viewInsuranceType').textContent = insuranceTypeName || '-';
                document.getElementById('viewPremiumAmount').textContent = premiumAmount ? `$${parseFloat(premiumAmount).toFixed(2)}` : '-';
                document.getElementById('viewDuration').textContent = duration ? `${duration} Months` : '-';
                document.getElementById('viewCoverageAmount').textContent = coverageAmount ? `$${parseFloat(coverageAmount).toFixed(2)}` : '-';
                document.getElementById('viewTerms').textContent = terms;

                // Status Badge
                const statusBadge = document.getElementById('viewStatusBadge');
                if (status) {
                    statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                    statusBadge.textContent = 'Active';
                } else {
                    statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                    statusBadge.textContent = 'Inactive';
                }

                document.getElementById('viewCreatedAt').textContent = createdAt || '-';

                // Check if user has already applied for this policy
                const applicationStatusSection = document.getElementById('applicationStatusSection');
                const myApplicationStatus = document.getElementById('myApplicationStatus');
                const myAppliedDate = document.getElementById('myAppliedDate');

                // Check row for application status
                const currentRow = button.closest('tr');
                const rowStatusBadge = currentRow?.querySelector('span.badge.rounded-pill');

                if (rowStatusBadge && !rowStatusBadge.classList.contains('bg-success-subtle') &&
                    !rowStatusBadge.classList.contains('bg-danger-subtle')) {
                    // User has applied
                    applicationStatusSection.classList.remove('d-none');
                    myApplicationStatus.textContent = rowStatusBadge.textContent.trim();
                    myApplicationStatus.className = rowStatusBadge.className;
                    myAppliedDate.textContent = 'Applied: ' + (new Date().toLocaleDateString());
                } else {
                    applicationStatusSection.classList.add('d-none');
                }

                // Apply button in view modal
                const applyBtn = document.getElementById('viewApplyPolicyBtn');
                if (rowStatusBadge && rowStatusBadge.textContent.trim() === 'Applied') {
                    applyBtn.disabled = true;
                    applyBtn.innerHTML = '<i class="bx bx-check me-1"></i>Already Applied';
                    applyBtn.classList.remove('btn-primary');
                    applyBtn.classList.add('btn-secondary');
                } else {
                    applyBtn.disabled = false;
                    applyBtn.innerHTML = 'Apply for This Policy';
                    applyBtn.classList.remove('btn-secondary');
                    applyBtn.classList.add('btn-primary');

                    applyBtn.onclick = function() {
                        const modalInstance = bootstrap.Modal.getInstance(viewModal);
                        modalInstance.hide();

                        setTimeout(() => {
                            const fakeApplyBtn = document.createElement('button');
                            fakeApplyBtn.setAttribute('data-bs-toggle', 'modal');
                            fakeApplyBtn.setAttribute('data-bs-target', '#applyPolicyModal');
                            fakeApplyBtn.setAttribute('data-policyid', policyId);
                            fakeApplyBtn.setAttribute('data-policyname', policyName);
                            fakeApplyBtn.setAttribute('data-premiumamount', premiumAmount);
                            document.body.appendChild(fakeApplyBtn);
                            fakeApplyBtn.click();
                            fakeApplyBtn.remove();
                        }, 150);
                    };
                }
            });


            // ==================== UTILITY: Show Alert ====================
            function showAlert(type, message) {
                // Create toast/alert element
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3 shadow-sm`;
                alertDiv.style.zIndex = '9999';
                alertDiv.role = 'alert';
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);

                // Auto-remove after 5 seconds
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            }


            // ==================== EXPORT FUNCTIONS (IDENTICAL TO ADMIN) ====================
            window.exportTable = function(format, tableId, filename) {
                const table = document.getElementById(tableId);
                if (!table) return;

                // Simple implementation - replace with your preferred library
                if (format === 'excel') {
                    let csv = [];
                    const rows = table.querySelectorAll("tr");

                    for (let row of rows) {
                        let cols = row.querySelectorAll("td, th");
                        let data = [];
                        for (let col of cols) {
                            let text = col.innerText.replace(/"/g, '""');
                            data.push('"' + text + '"');
                        }
                        csv.push(data.join(","));
                    }

                    const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
                    const downloadLink = document.createElement("a");
                    downloadLink.href = URL.createObjectURL(csvFile);
                    downloadLink.download = `${filename}_${new Date().toISOString().slice(0,10)}.csv`;
                    downloadLink.click();
                }
                // Add PDF export logic as needed
            };

        });
    </script>
}