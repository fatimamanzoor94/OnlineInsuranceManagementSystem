@model OnlineInsuranceManagementSystem.ViewModels.CustomerClaimsIndexViewModel
@{
    ViewData["Title"] = "My Claims";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">My Claims</h4>
                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 rounded-pill px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#addClaimModal">
                    <i class="bx bx-plus"></i> Submit Claim
                </button>
            </div>

            <!-- TOP SUMMARY CARDS (EXACT SAME DESIGN AS ADMIN) -->
            <div class="row g-3 mb-4">
                <!-- Total Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-clipboard2-check text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Total Claims</h6>
                                <small class="text-muted" id="totalClaims">@Model.TotalClaims</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <!-- Pending Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-hourglass-split text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Pending Claims</h6>
                                <small class="text-muted" id="pendingClaims">@Model.PendingClaims</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <!-- Approved Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-check-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Approved Claims</h6>
                                <small class="text-muted" id="approvedClaims">@Model.ApprovedClaims</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
                <!-- Rejected Claims -->
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card custom-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="icon-box">
                                    <i class="bi bi-x-circle text-dark"></i>
                                </div>
                                <h6 class="card-title mt-3 mb-1">Rejected Claims</h6>
                                <small class="text-muted" id="rejectedClaims">@Model.RejectedClaims</small>
                            </div>
                            <i class="bx bx-trending-up trend-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter (EXACT SAME DESIGN AS ADMIN) -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Claim ID</label>
                            <input type="text" id="searchClaimId"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter claim ID..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Policy</label>
                            <input type="text" id="searchName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter policy name..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Filter Status</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill active" data-filter="all">All</button>
                                <button class="btn btn-sm btn-outline-warning rounded-pill" data-filter="pending">Pending</button>
                                <button class="btn btn-sm btn-outline-success rounded-pill" data-filter="approved">Approved</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill" data-filter="rejected">Rejected</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table (EXACT SAME DESIGN AS ADMIN) -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">My Claims</h4>
                            <small class="text-muted">Track your insurance claims status</small>
                        </div>
                        <!-- Export Buttons (SAME FUNCTION AS ADMIN) -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'claimsTable', 'MyClaims')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'claimsTable', 'MyClaims')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="claimsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Claim ID</th>
                                    <th>Policy Name</th>
                                    <th>Insurance Type</th>
                                    <th>Claim Amount</th>
                                    <th>Claim Date</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.Claims)
                                {
                                    <tr data-status="@claim.Status.ToLower()">
                                        <td>@claim.ClaimIdDisplay</td>
                                        <td>@claim.PolicyName</td>
                                        <td>@claim.InsuranceTypeName</td>
                                        <td class="fw-semibold text-primary">$@claim.ClaimAmountDisplay</td>
                                        <td>@claim.ClaimDateDisplay</td>
                                        <td>
                                            <span class="badge @claim.StatusBadgeClass">@claim.StatusText</span>
                                        </td>
                                        <td>
                                            <span class="text-muted small">@(string.IsNullOrEmpty(claim.Reason) ? "-" : claim.Reason)</span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm d-flex gap-2">
                                                <!-- ✅ VIEW DETAILS BUTTON -->
                                                <button class="btn btn-outline-info view-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#viewClaimModal"
                                                        data-claimid="@claim.ClaimId"
                                                        data-policyname="@claim.PolicyName"
                                                        data-insurancetype="@claim.InsuranceTypeName"
                                                        data-claimamount="@claim.ClaimAmount.ToString("F2")"
                                                        data-claimdate="@claim.ClaimDateDisplay"
                                                        data-status="@claim.Status"
                                                        data-reason="@(claim.Reason ?? "-")"
                                                        title="View Details">
                                                    View
                                                </button>

                                                <!-- ✅ TRACK STATUS BUTTON -->
                                                <button class="btn btn-outline-warning track-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#trackClaimModal"
                                                        data-claimid="@claim.ClaimId"
                                                        title="Track Claim Status">
                                                    Track
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination (EXACT SAME AS ADMIN) -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Claims: @Model.Claims.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== SUBMIT CLAIM MODAL (Replaces Admin Add Modal) ==================== -->
<div class="modal fade" id="addClaimModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Submit New Claim</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form id="submitClaimForm">
                    @Html.AntiForgeryToken()

                    <!-- Policy Dropdown -->
                    <select name="PolicyId" id="claimPolicyId" class="form-select mb-2 rounded-pill" required>
                        <option value="">Select Policy</option>
                        @if (Model.ApprovedPolicies.Any())
                        {
                            @foreach (var policy in Model.ApprovedPolicies)
                            {
                                <option value="@policy.PolicyId"
                                        data-coverage="@policy.CoverageAmount"
                                        data-insurance="@policy.InsuranceTypeName">
                                    @policy.PolicyName (@policy.InsuranceTypeName)
                                </option>
                            }
                        }
                        else
                        {
                            <option value="" disabled>No approved policies available</option>
                        }
                    </select>
                    <small class="text-muted ms-2" id="policyCoverageInfo"></small>

                    <!-- Show helpful message if no policies -->
                    @if (!Model.ApprovedPolicies.Any())
                    {
                        <div class="alert alert-warning rounded-3 small mb-3">
                            <i class="bx bx-error-circle me-1"></i>
                            <strong>No approved policies:</strong> You must first apply for and get approval on a policy before submitting claims.
                            <a href="@Url.Action("Policies", "Customer")" class="fw-semibold">Browse Policies →</a>
                        </div>
                    }

                    <!-- Claim Amount -->
                    <input type="number" name="ClaimAmount" id="claimAmount"
                           class="form-control mb-2 rounded-pill"
                           placeholder="Enter claim amount"
                           step="0.01" min="0" required />

                    <!-- Claim Date (Auto-filled, read-only) -->
                    <input type="date" name="ClaimDate" id="claimDate"
                           class="form-control mb-2 rounded-pill"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                           readonly />

                    <!-- Reason Textarea -->
                    <textarea name="Reason" id="claimReason"
                              class="form-control mb-2 rounded-3"
                              placeholder="Enter claim reason (required)"
                              rows="3" required></textarea>

                    <div class="alert alert-info rounded-3 small mb-3">
                        <i class="bx bx-info-circle me-1"></i>
                        Your claim will be reviewed by our team. You will be notified once approved or rejected.
                    </div>

                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitClaimBtn">
                            Submit Claim
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW CLAIM DETAILS MODAL (Same Structure as Admin) ==================== -->
<div class="modal fade" id="viewClaimModal" tabindex="-1" aria-labelledby="viewClaimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-clipboard text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewClaimModalLabel">Claim Details</h5>
                        <small class="text-muted" id="viewClaimIdDisplay">#CLM-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Policy Name -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-shield me-1"></i>Policy Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewPolicyName">-</p>
                        </div>
                        <!-- Insurance Type -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-category me-1"></i>Insurance Type</label>
                            <p class="form-control-plaintext mb-0" id="viewInsuranceType">-</p>
                        </div>
                        <!-- Claim Amount -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-dollar me-1"></i>Claim Amount</label>
                            <p class="form-control-plaintext fw-semibold text-primary mb-0" id="viewClaimAmount">-</p>
                        </div>
                        <!-- Claim Date -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Claim Date</label>
                            <p class="form-control-plaintext mb-0" id="viewClaimDate">-</p>
                        </div>
                        <!-- Status & Reason -->
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-note me-1"></i>Reason</label>
                                <p class="form-control-plaintext mb-0" id="viewReason">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="viewTrackClaimBtn">
                    Track Status
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== TRACK CLAIM STATUS MODAL (Same Structure as Admin Edit Modal) ==================== -->
<div class="modal fade" id="trackClaimModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Claim Tracking</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Timeline Header -->
                        <div class="mb-4 text-center">
                            <h6 class="fw-semibold mb-1" id="trackPolicyName">-</h6>
                            <span id="trackCurrentStatus" class="badge rounded-pill">-</span>
                        </div>

                        <!-- Timeline Items -->
                        <div class="timeline" id="trackTimelineContainer">
                            <!-- Dynamic timeline items will be inserted here by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES (EXACT SAME AS ADMIN) ==================== -->
<style>
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        background: #ffffff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .delete-icon {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .delete-icon i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* View Modal Enhancements */
    #viewClaimModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewClaimModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    #viewClaimModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        #viewClaimModal .card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    /* Timeline Styles */
    .timeline {
        position: relative;
        padding-left: 30px;
        margin: 0;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 8px;
            top: 10px;
            bottom: 10px;
            width: 2px;
            background: #dee2e6;
        }

    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -26px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #0d6efd;
            border: 3px solid #fff;
            box-shadow: 0 0 0 2px #0d6efd;
        }

        .timeline-item.approved::before {
            background: #198754;
            box-shadow: 0 0 0 2px #198754;
        }

        .timeline-item.rejected::before {
            background: #dc3545;
            box-shadow: 0 0 0 2px #dc3545;
        }

    .timeline-date {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .timeline-event {
        font-weight: 600;
        color: #212529;
        margin-bottom: 2px;
    }

    .timeline-desc {
        font-size: 0.9rem;
        color: #495057;
    }

    @@media (max-width: 576px) {
        #viewClaimModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewClaimModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT (SAME BEHAVIOR AS ADMIN) ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==================== SEARCH FUNCTIONALITY (EXACT SAME AS ADMIN) ====================
            const searchClaimId = document.getElementById('searchClaimId');
            const searchName = document.getElementById('searchName');

            function filterTable() {
                const claimIdVal = searchClaimId.value.toLowerCase();
                const nameVal = searchName.value.toLowerCase();

                document.querySelectorAll("#claimsTable tbody tr").forEach(row => {
                    const claimId = row.cells[0]?.textContent.toLowerCase() || '';
                    const policyName = row.cells[1]?.textContent.toLowerCase() || '';
                    const insuranceType = row.cells[2]?.textContent.toLowerCase() || '';

                    const matches = (claimId.includes(claimIdVal)) &&
                                   (policyName.includes(nameVal) || insuranceType.includes(nameVal));

                    row.style.display = matches ? "" : "none";
                });
            }

            searchClaimId.addEventListener("input", filterTable);
            searchName.addEventListener("input", filterTable);


            // ==================== PAGINATION (EXACT SAME AS ADMIN) ====================
            const rowsPerPage = 10;
            const tableRows = document.querySelectorAll("#claimsTable tbody tr");
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function displayTablePage(page) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                tableRows.forEach((row, index) => {
                    // Respect search/filter visibility
                    if (row.style.display === "none") {
                        row.dataset.hiddenByFilter = "true";
                    } else {
                        row.dataset.hiddenByFilter = "false";
                    }

                    const isVisible = row.dataset.hiddenByFilter !== "true";
                    const isInPage = index >= start && index < end;
                    row.style.display = (isVisible && isInPage) ? "" : "none";
                });
                updatePaginationButtons();
            }

            function updatePaginationButtons() {
                const visibleRows = Array.from(tableRows).filter(row => row.dataset.hiddenByFilter !== "true");
                const pageCount = Math.ceil(visibleRows.length / rowsPerPage) || 1;

                if (currentPage > pageCount) currentPage = 1;
                pagination.innerHTML = "";

                // Prev Button
                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prevLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage > 1) displayTablePage(currentPage - 1);
                });
                pagination.appendChild(prevLi);

                // Page Numbers
                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(pageCount, startPage + 4);
                if (endPage - startPage < 4 && pageCount > 5) startPage = Math.max(1, endPage - 4);

                for (let i = startPage; i <= endPage; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${currentPage === i ? "active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", function (e) {
                        e.preventDefault();
                        displayTablePage(i);
                    });
                    pagination.appendChild(li);
                }

                // Next Button
                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                nextLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage < pageCount) displayTablePage(currentPage + 1);
                });
                pagination.appendChild(nextLi);
            }

            displayTablePage(1);

            // Re-apply pagination after filter changes
            const originalFilterTable = filterTable;
            filterTable = function() {
                originalFilterTable();
                currentPage = 1;
                displayTablePage(1);
            };


            // ==================== STATUS FILTER (EXACT SAME AS ADMIN) ====================
            document.querySelectorAll("[data-filter]").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    const filter = this.getAttribute('data-filter');
                    const rows = document.querySelectorAll("#claimsTable tbody tr");

                    rows.forEach(row => {
                        const rowStatus = row.getAttribute('data-status');
                        let showRow = (filter === 'all') || (filter === rowStatus);

                        // Also respect search filters
                        const claimIdVal = searchClaimId.value.toLowerCase();
                        const nameVal = searchName.value.toLowerCase();
                        const claimId = row.cells[0]?.textContent.toLowerCase() || '';
                        const policyName = row.cells[1]?.textContent.toLowerCase() || '';
                        const insuranceType = row.cells[2]?.textContent.toLowerCase() || '';
                        const nameMatch = policyName.includes(nameVal) || insuranceType.includes(nameVal);
                        const claimIdMatch = claimId.includes(claimIdVal);

                        if (showRow && nameMatch && claimIdMatch) {
                            row.style.display = '';
                            row.dataset.hiddenByFilter = 'false';
                        } else {
                            row.style.display = 'none';
                            row.dataset.hiddenByFilter = 'true';
                        }
                    });

                    currentPage = 1;
                    displayTablePage(1);
                });
            });


            // ==================== SUBMIT CLAIM FORM (AJAX) ====================
            document.getElementById('submitClaimForm')?.addEventListener('submit', async function(e) {
                e.preventDefault();

                const submitBtn = document.getElementById('submitClaimBtn');
                const originalBtnText = submitBtn.innerHTML;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> Submitting...';

                try {
                    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const policyId = document.getElementById('claimPolicyId').value;
                    const claimAmount = document.getElementById('claimAmount').value;
                    const reason = document.getElementById('claimReason').value;

                    if (!policyId || !claimAmount || !reason) {
                        throw new Error('Please fill all required fields');
                    }

                    const formData = new FormData();
                    formData.append('PolicyId', policyId);
                    formData.append('ClaimAmount', claimAmount);
                    formData.append('Reason', reason);
                    formData.append('__RequestVerificationToken', csrfToken);

                    const response = await fetch('/Customer/CreateClaim', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        showAlert('success', result.message);

                        const modalInstance = bootstrap.Modal.getInstance(document.getElementById('addClaimModal'));
                        modalInstance.hide();

                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showAlert('danger', result.message || 'Failed to submit claim.');
                    }
                } catch (error) {
                    console.error('Submit claim error:', error);
                    showAlert('danger', 'Network error. Please try again.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                }
            });


            // ==================== POLICY COVERAGE INFO DISPLAY ====================
            document.getElementById('claimPolicyId')?.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                const coverage = selectedOption.getAttribute('data-coverage');
                const insurance = selectedOption.getAttribute('data-insurance');

                if (coverage) {
                    document.getElementById('policyCoverageInfo').textContent =
                        `Coverage Amount: $${parseFloat(coverage).toFixed(2)}`;
                } else {
                    document.getElementById('policyCoverageInfo').textContent = '';
                }
            });


            // ==================== VIEW MODAL - Populate Claim Data ====================
            const viewModal = document.getElementById('viewClaimModal');
            viewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                document.getElementById('viewClaimIdDisplay').textContent = `#CLM-${button.getAttribute('data-claimid')}`;
                document.getElementById('viewPolicyName').textContent = button.getAttribute('data-policyname') || '-';
                document.getElementById('viewInsuranceType').textContent = button.getAttribute('data-insurancetype') || '-';
                document.getElementById('viewClaimAmount').textContent = `$${parseFloat(button.getAttribute('data-claimamount')).toFixed(2)}`;
                document.getElementById('viewClaimDate').textContent = button.getAttribute('data-claimdate') || '-';
                document.getElementById('viewReason').textContent = button.getAttribute('data-reason') || '-';

                // Status Badge
                const status = button.getAttribute('data-status')?.toLowerCase();
                const statusBadge = document.getElementById('viewStatusBadge');
                if (status === 'approved') {
                    statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                    statusBadge.textContent = 'Approved';
                } else if (status === 'rejected') {
                    statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                    statusBadge.textContent = 'Rejected';
                } else {
                    statusBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
                    statusBadge.textContent = 'Pending';
                }

                // Track button in view modal
                document.getElementById('viewTrackClaimBtn').onclick = function() {
                    const modalInstance = bootstrap.Modal.getInstance(viewModal);
                    modalInstance.hide();
                    setTimeout(() => {
                        const fakeTrackBtn = document.createElement('button');
                        fakeTrackBtn.setAttribute('data-bs-toggle', 'modal');
                        fakeTrackBtn.setAttribute('data-bs-target', '#trackClaimModal');
                        fakeTrackBtn.setAttribute('data-claimid', button.getAttribute('data-claimid'));
                        document.body.appendChild(fakeTrackBtn);
                        fakeTrackBtn.click();
                        fakeTrackBtn.remove();
                    }, 150);
                };
            });


            // ==================== TRACK CLAIM MODAL - Build Timeline ====================
            const trackModal = document.getElementById('trackClaimModal');
            trackModal.addEventListener('show.bs.modal', async function (event) {
                const button = event.relatedTarget;
                const claimId = button.getAttribute('data-claimid');
                const timelineContainer = document.getElementById('trackTimelineContainer');

                timelineContainer.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> Loading...</div>';

                try {
                    const response = await fetch(`/Customer/GetClaimDetails?claimId=${claimId}`);
                    const data = await response.json();

                    if (data.error) throw new Error(data.error);

                    document.getElementById('trackPolicyName').textContent = data.policyName;
                    const statusBadge = document.getElementById('trackCurrentStatus');
                    statusBadge.textContent = data.status;
                    statusBadge.className = `badge rounded-pill ${data.statusBadgeClass}`;

                    // Build timeline
                    timelineContainer.innerHTML = '';

                    // Submitted event
                    timelineContainer.innerHTML += `
                        <div class="timeline-item">
                            <div class="timeline-date">${data.claimDateFormatted}</div>
                            <div class="timeline-event">Claim Submitted</div>
                            <div class="timeline-desc">Claim amount: $${data.claimAmountFormatted}</div>
                        </div>
                    `;

                    // Status event
                    if (data.status === 'Approved') {
                        timelineContainer.innerHTML += `
                            <div class="timeline-item approved">
                                <div class="timeline-event">Claim Approved</div>
                                <div class="timeline-desc">Your claim has been approved and payment will be processed.</div>
                            </div>
                        `;
                    } else if (data.status === 'Rejected') {
                        timelineContainer.innerHTML += `
                            <div class="timeline-item rejected">
                                <div class="timeline-event">Claim Rejected</div>
                                <div class="timeline-desc">${data.reason}</div>
                            </div>
                        `;
                    } else {
                        timelineContainer.innerHTML += `
                            <div class="timeline-item">
                                <div class="timeline-event">Under Review</div>
                                <div class="timeline-desc">Our team is reviewing your claim.</div>
                            </div>
                        `;
                    }
                } catch (error) {
                    console.error('Track claim error:', error);
                    timelineContainer.innerHTML = '<div class="alert alert-danger small">Failed to load tracking info</div>';
                }
            });


            // ==================== UTILITY: Show Alert ====================
            function showAlert(type, message) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3 shadow-sm`;
                alertDiv.style.zIndex = '9999';
                alertDiv.role = 'alert';
                alertDiv.innerHTML = `${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
                document.body.appendChild(alertDiv);
                setTimeout(() => { if (alertDiv.parentNode) alertDiv.remove(); }, 5000);
            }


            // ==================== EXPORT FUNCTIONS (EXACT SAME AS ADMIN) ====================
            window.exportTable = function(format, tableId, filename) {
                const table = document.getElementById(tableId);
                if (!table) return;

                if (format === 'excel') {
                    let csv = [];
                    const rows = table.querySelectorAll("tr");
                    for (let row of rows) {
                        let cols = row.querySelectorAll("td, th");
                        let data = [];
                        for (let col of cols) {
                            let text = col.innerText.replace(/"/g, '""');
                            data.push('"' + text + '"');
                        }
                        csv.push(data.join(","));
                    }
                    const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
                    const downloadLink = document.createElement("a");
                    downloadLink.href = URL.createObjectURL(csvFile);
                    downloadLink.download = `${filename}_${new Date().toISOString().slice(0,10)}.csv`;
                    downloadLink.click();
                }
            };

        });
    </script>
}