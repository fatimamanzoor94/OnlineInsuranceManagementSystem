            // ============ UTILITY: Format currency for display ============
            function formatCurrency(amount) {
                return '$' + parseFloat(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // ============ INITIALIZE: Re-attach listeners after DOM updates ============
            function initializeViewButtons() {
                document.querySelectorAll('.view-details').forEach(btn => {
                    btn.removeEventListener('click', loadPolicyDetails);
                    btn.addEventListener('click', function () {
                        const policyId = this.getAttribute('data-policy-id');
                        loadPolicyDetails(policyId);
                    });
                });
            }

            // Run initialization
            initializeViewButtons();

