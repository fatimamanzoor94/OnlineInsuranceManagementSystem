@model List<OnlineInsuranceManagementSystem.Models.User>
@{
    ViewData["Title"] = "Agents Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Agents Management</h4>
                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 rounded-pill px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#addAgentModal">
                    <i class="bx bx-plus"></i> Add Agent
                </button>
            </div>

            <!-- Search & Filter -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Name</label>
                            <input type="text" id="searchName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter full name..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Email</label>
                            <input type="email" id="searchEmail"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter email..." />
                        </div>
                        
                        
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">All Agents</h4>
                            <small class="text-muted">Manage your agent accounts</small>
                        </div>
                        <!-- Export Buttons -->
                        <div class="d-flex gap-2">
                            <div class="d-flex gap-2">
                                <button type="button"
                                        onclick="exportTable('excel', 'agentsTable', 'Agents')"
                                        class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                                </button>

                                <button type="button"
                                        onclick="exportTable('pdf', 'agentsTable', 'Agents')"
                                        class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="agentsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Agent ID</th>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    @* <th>Address</th> *@
                                    <th>Account Status</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agent in Model)
                                {
                                    <tr>
                                        <td>#AGT-@agent.UserId</td>
                                        <td>@agent.FullName</td>
                                        <td>@agent.Email</td>
                                        <td>@agent.Phone</td>
                                        @* <td>@(agent.Address ?? "N/A")</td> *@
                                        <td>
                                            @if (agent.AccountStatus == "Approved")
                                            {
                                                <span class="badge bg-success-subtle text-success">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (agent.Status)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>@agent.CreatedAt.ToString("dd-MMM-yyyy")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm d-flex gap-2">
                                                <!-- VIEW BUTTON -->
                                                <button class="btn btn-outline-info view-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#viewAgentModal"
                                                        data-agentid="@agent.UserId"
                                                        data-fullname="@agent.FullName"
                                                        data-email="@agent.Email"
                                                        data-phone="@agent.Phone"
                                                        @* data-address="@(agent.Address ?? "N/A")" *@
                                                        data-accountstatus="@agent.AccountStatus"
                                                        data-status="@agent.Status"
                                                        data-createdat="@agent.CreatedAt.ToString("dd-MMM-yyyy")"
                                                        title="View Details">
                                                    View
                                                </button>

                                                <!-- EDIT BUTTON -->
                                                <button class="btn btn-outline-warning edit-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editAgentModal"
                                                        data-agentid="@agent.UserId"
                                                        data-fullname="@agent.FullName"
                                                        data-email="@agent.Email"
                                                        data-phone="@agent.Phone"
                                                        @* data-address="@(agent.Address ?? "N/A")" *@
                                                        data-status="@agent.Status"
                                                        title="Edit">
                                                    Edit
                                                </button>

                                                <!-- APPROVE BUTTON (only if Pending) -->
                                                @if (agent.AccountStatus != "Approved")
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-success approve-btn"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#approveAgentModal"
                                                            data-agentid="@agent.UserId"
                                                            data-agentname="@agent.FullName"
                                                            title="Approve Agent">

                                                        Approve
                                                    </button>
                                                }

                                                <!-- TOGGLE STATUS BUTTON -->
                                                <button type="button"
                                                        class="btn @(agent.Status ? "btn-outline-danger" : "btn-outline-success") status-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#statusAgentModal"
                                                        data-agentid="@agent.UserId"
                                                        data-agentname="@agent.FullName"
                                                        data-agentstatus="@agent.Status"
                                                        title="@(agent.Status ? "Deactivate" : "Activate") Agent">

                                                    @(agent.Status ? "Deactivate" : "Activate")
                                                </button>

                                                <!-- DELETE BUTTON -->
                                                <button type="button"
                                                        class="btn btn-outline-danger delete-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteAgentModal"
                                                        data-agentid="@agent.UserId"
                                                        data-agentname="@agent.FullName"
                                                        title="Delete">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Agents: @Model.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ADD AGENT MODAL ==================== -->
<div class="modal fade" id="addAgentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Add New Agent</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="CreateAgent" method="post">
                    <input type="text" name="FullName" class="form-control mb-2 rounded-pill" placeholder="Full Name" required pattern="[A-Za-z ]{3,100}" title="Only alphabets allowed (3-100 characters)" />
                    <input type="email" name="Email" class="form-control mb-2 rounded-pill" placeholder="Email" required />
                    <input type="password" name="Password" class="form-control mb-2 rounded-pill" placeholder="Password" required minlength="6" title="Password must be at least 6 characters" />
                    <input type="tel" name="Phone" class="form-control mb-2 rounded-pill" placeholder="03XXXXXXXXX" required pattern="03[0-9]{9}" title="Phone format should be 03XXXXXXXXX" />
                    @* <textarea name="Address" class="form-control mb-2 rounded-3" placeholder="Address"></textarea> *@
                    <input type="hidden" name="Role" value="Agent" />
                    <input type="hidden" name="AccountStatus" value="Pending" />
                    <select name="Status" class="form-select mb-2 rounded-pill">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Save Agent</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== EDIT AGENT MODAL ==================== -->
<div class="modal fade" id="editAgentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Edit Agent</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="EditAgent" method="post">
                    <input type="hidden" id="editAgentId" name="UserId" />
                    <input type="text" id="editFullName" name="FullName" class="form-control mb-2 rounded-pill" placeholder="Full Name" required pattern="[A-Za-z ]{3,100}" />
                    <input type="email" id="editEmail" name="Email" class="form-control mb-2 rounded-pill" placeholder="Email" required />
                    <input type="tel" id="editPhone" name="Phone" class="form-control mb-2 rounded-pill" placeholder="03XXXXXXXXX" required pattern="03[0-9]{9}" />
                    @* <textarea id="editAddress" name="Address" class="form-control mb-2 rounded-3" placeholder="Address"></textarea> *@
                    <select id="editStatus" name="Status" class="form-select mb-2 rounded-pill">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Update Agent</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DELETE AGENT MODAL ==================== -->
<div class="modal fade" id="deleteAgentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icon-box">
                    <i class="fas fa-trash-alt"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Delete Agent?</h4>
                <p class="text-muted">
                    You are about to delete <strong id="deleteAgentName"></strong><br />
                    This action cannot be undone.
                </p>
                <form asp-action="DeleteAgent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteAgentId" name="id" />
                    <div class="d-flex gap-2 justify-content-center mt-3">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4 rounded-pill">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== APPROVE AGENT MODAL ==================== -->
<div class="modal fade" id="approveAgentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">

            <!-- ICON -->
            <div class="delete-icon-wrapper">
                <div class="icon-box" id="approveIconBox">
                    <i id="approveIcon" class="fas fa-user-check"></i>
                </div>
            </div>

            <div class="modal-body text-center pt-5 pb-4">

                <h4 class="fw-bold">
                    Approve Agent?
                </h4>

                <p class="text-muted" id="approveModalText">
                    You are about to approve this agent.
                </p>

                <form asp-action="ApproveAgent" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="approveAgentId"
                           name="id" />

                    <div class="d-flex gap-2 justify-content-center mt-3">

                        <button type="button"
                                class="btn btn-outline-secondary px-4 rounded-pill"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-success px-4 rounded-pill">
                            Approve
                        </button>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
<style>
    #approveIconBox {
        background: #f0fff4;
    }

    #approveIcon {
        color: #22c55e !important;
    }
</style>

<!-- ==================== ACTIVATE / DEACTIVATE MODAL ==================== -->
<div class="modal fade" id="statusAgentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">

            <!-- ICON -->
            <div class="delete-icon-wrapper">
                <div class="icon-box" id="statusIconBox">
                    <i id="statusIcon" class="fas fa-user-slash"></i>
                </div>
            </div>

            <div class="modal-body text-center pt-5 pb-4">

                <h4 class="fw-bold" id="statusModalTitle">
                    Deactivate Agent?
                </h4>

                <p class="text-muted" id="statusModalText">
                    You are about to deactivate this agent.
                </p>

                <form asp-action="ToggleAgentStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="statusAgentId" name="id" />

                    <div class="d-flex gap-2 justify-content-center mt-3">

                        <button type="button"
                                class="btn btn-outline-secondary px-4 rounded-pill"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                id="statusConfirmBtn"
                                class="btn px-4 rounded-pill">
                            Confirm
                        </button>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW AGENT DETAILS MODAL ==================== -->
<div class="modal fade" id="viewAgentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-user text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0">Agent Details</h5>
                        <small class="text-muted" id="viewAgentIdDisplay">#AGT-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Full Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewFullName">-</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-envelope me-1"></i>Email</label>
                            <p class="form-control-plaintext mb-0"><a href="#" id="viewEmailLink" class="text-decoration-none">-</a></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-phone me-1"></i>Phone</label>
                            <p class="form-control-plaintext mb-0"><a href="#" id="viewPhoneLink" class="text-decoration-none">-</a></p>
                        </div>
                        <div class="mb-3">
                            @* <label class="form-label small text-muted mb-1"><i class="bx bx-map me-1"></i>Address</label> *@
                            @* <p class="form-control-plaintext mb-0" id="viewAddress">-</p> *@
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Account Status</label>
                                <span id="viewAccountStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-check-circle me-1"></i>Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Created Date</label>
                            <p class="form-control-plaintext fw-medium mb-0" id="viewCreatedAt">-</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="viewEditAgentBtn">Edit Agent</button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS (Same as Customers) ==================== -->
<style>
    /* Delete Modal Animation */
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0,0,0,0.25);
        background: #fff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icon-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icon-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
    /* View Modal */
    #viewAgentModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewAgentModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    @@media (max-width: 576px) {
        #viewAgentModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewAgentModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT (Adapted for Agents) ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Search
            const searchName = document.getElementById('searchName');
            const searchEmail = document.getElementById('searchEmail');
            function filterTable() {
                const nameVal = searchName.value.toLowerCase();
                const emailVal = searchEmail.value.toLowerCase();
                document.querySelectorAll("#agentsTable tbody tr").forEach(row => {
                    const name = row.cells[1]?.textContent.toLowerCase() || '';
                    const email = row.cells[2]?.textContent.toLowerCase() || '';
                    row.style.display = (name.includes(nameVal) && email.includes(emailVal)) ? "" : "none";
                });
            }
            searchName.addEventListener("input", filterTable);
            searchEmail.addEventListener("input", filterTable);

            // Status Filter
            document.querySelectorAll("[data-filter]").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    const filter = this.getAttribute('data-filter');
                    document.querySelectorAll("#agentsTable tbody tr").forEach(row => {
                        const statusBadge = row.cells[6]?.querySelector('.badge');
                        const isActive = statusBadge?.classList.contains('bg-success-subtle');
                        if (filter === 'all') row.style.display = '';
                        else if (filter === 'active' && isActive) row.style.display = '';
                        else if (filter === 'inactive' && !isActive) row.style.display = '';
                        else row.style.display = 'none';
                    });
                });
            });

            // Approval Filter
            document.querySelectorAll("[data-approval]").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll("[data-approval]").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    const approval = this.getAttribute('data-approval');
                    document.querySelectorAll("#agentsTable tbody tr").forEach(row => {
                        const accountStatus = row.cells[5]?.textContent.trim();
                        if (approval === 'all' || accountStatus === approval) row.style.display = '';
                        else row.style.display = 'none';
                    });
                });
            });

            // Pagination
            const rowsPerPage = 10;
            const tableRows = document.querySelectorAll("#agentsTable tbody tr");
            const pagination = document.getElementById("pagination");
            let currentPage = 1;
            function displayTablePage(page) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage, end = start + rowsPerPage;
                tableRows.forEach((row, i) => row.style.display = (i >= start && i < end) ? "" : "none");
                updatePaginationButtons();
            }
            function updatePaginationButtons() {
                pagination.innerHTML = "";
                const pageCount = Math.ceil(tableRows.length / rowsPerPage);
                const createBtn = (text, page, disabled) => {
                    const li = document.createElement("li");
                    li.className = `page-item ${disabled ? "disabled" : ""}`;
                    li.innerHTML = `<a class="page-link ${page === 1 ? 'rounded-start-pill' : page === pageCount ? 'rounded-end-pill' : ''}" href="#">${text}</a>`;
                    li.addEventListener("click", e => { e.preventDefault(); if (!disabled) displayTablePage(page); });
                    return li;
                };
                pagination.appendChild(createBtn("Prev", currentPage - 1, currentPage === 1));
                for (let i = 1; i <= pageCount; i++) pagination.appendChild(createBtn(i.toString(), i, currentPage === i));
                pagination.appendChild(createBtn("Next", currentPage + 1, currentPage === pageCount));
            }
            displayTablePage(1);

            // Edit Modal
            document.getElementById('editAgentModal').addEventListener('show.bs.modal', function (e) {
                const btn = e.relatedTarget;
                document.getElementById('editAgentId').value = btn.getAttribute('data-agentid');
                document.getElementById('editFullName').value = btn.getAttribute('data-fullname');
                document.getElementById('editEmail').value = btn.getAttribute('data-email');
                document.getElementById('editPhone').value = btn.getAttribute('data-phone');
                // document.getElementById('editAddress').value = btn.getAttribute('data-address');
                document.getElementById('editStatus').value = btn.getAttribute('data-status')?.toLowerCase() === 'true' ? 'true' : 'false';
            });

            // Delete Modal
            document.getElementById('deleteAgentModal').addEventListener('show.bs.modal', function (e) {
                const btn = e.relatedTarget;
                document.getElementById('deleteAgentId').value = btn.getAttribute('data-agentid');
                document.getElementById('deleteAgentName').textContent = btn.getAttribute('data-agentname');
            });

                    // APPROVE MODAL
        document.getElementById('approveAgentModal')
        .addEventListener('show.bs.modal', function (e) {

            const btn = e.relatedTarget;

            const agentId = btn.getAttribute('data-agentid');
            const agentName = btn.getAttribute('data-agentname');

            document.getElementById('approveAgentId').value = agentId;

            document.getElementById('approveModalText').innerHTML = `
                You are about to approve
                <strong>${agentName}</strong><br/>
                The agent will receive an approval email
                and gain system access.
            `;
        });

                    // STATUS MODAL
        document.getElementById('statusAgentModal').addEventListener('show.bs.modal', function (e) {

            const btn = e.relatedTarget;

            const agentId = btn.getAttribute('data-agentid');
            const agentName = btn.getAttribute('data-agentname');
            const isActive = btn.getAttribute('data-agentstatus')?.toLowerCase() === 'true';

            document.getElementById('statusAgentId').value = agentId;

            const title = document.getElementById('statusModalTitle');
            const text = document.getElementById('statusModalText');
            const confirmBtn = document.getElementById('statusConfirmBtn');
            const icon = document.getElementById('statusIcon');
            const iconBox = document.getElementById('statusIconBox');

            if (isActive) {

                // DEACTIVATE UI
                title.textContent = 'Deactivate Agent?';

                text.innerHTML = `
                    You are about to deactivate
                    <strong>${agentName}</strong><br/>
                    The agent will lose system access.
                `;

                confirmBtn.className = 'btn btn-danger px-4 rounded-pill';
                confirmBtn.textContent = 'Deactivate';

                icon.className = 'fas fa-user-slash';
                icon.style.color = '#ff3b3b';

                iconBox.style.background = '#fff5f5';

            } else {

                // ACTIVATE UI
                title.textContent = 'Activate Agent?';

                text.innerHTML = `
                    You are about to activate
                    <strong>${agentName}</strong><br/>
                    The agent will regain system access.
                `;

                confirmBtn.className = 'btn btn-success px-4 rounded-pill';
                confirmBtn.textContent = 'Activate';

                icon.className = 'fas fa-user-check';
                icon.style.color = '#22c55e';

                iconBox.style.background = '#f0fff4';
            }
        });

            // View Modal
            document.getElementById('viewAgentModal').addEventListener('show.bs.modal', function (e) {
                const btn = e.relatedTarget;
                document.getElementById('viewAgentIdDisplay').textContent = `#AGT-${btn.getAttribute('data-agentid')}`;
                document.getElementById('viewFullName').textContent = btn.getAttribute('data-fullname');
                const emailLink = document.getElementById('viewEmailLink');
                emailLink.textContent = btn.getAttribute('data-email');
                emailLink.href = `mailto:${btn.getAttribute('data-email')}`;
                const phoneLink = document.getElementById('viewPhoneLink');
                phoneLink.textContent = btn.getAttribute('data-phone');
                phoneLink.href = `tel:${btn.getAttribute('data-phone')}`;
                // document.getElementById('viewAddress').textContent = btn.getAttribute('data-address');

                // Account Status Badge
                const accBadge = document.getElementById('viewAccountStatusBadge');
                const accStatus = btn.getAttribute('data-accountstatus');
                if (accStatus === 'Approved') {
                    accBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                    accBadge.textContent = 'Approved';
                } else {
                    accBadge.className = 'badge bg-warning-subtle text-warning rounded-pill';
                    accBadge.textContent = 'Pending';
                }

                // Status Badge
                const statusBadge = document.getElementById('viewStatusBadge');
                const status = btn.getAttribute('data-status')?.toLowerCase() === 'true';
                if (status) {
                    statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                    statusBadge.textContent = 'Active';
                } else {
                    statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                    statusBadge.textContent = 'Inactive';
                }

                document.getElementById('viewCreatedAt').textContent = btn.getAttribute('data-createdat');

                // Edit from View
                document.getElementById('viewEditAgentBtn').onclick = function() {
                    bootstrap.Modal.getInstance(document.getElementById('viewAgentModal')).hide();
                    setTimeout(() => {
                        const fakeBtn = document.createElement('button');
                        fakeBtn.setAttribute('data-bs-toggle', 'modal');
                        fakeBtn.setAttribute('data-bs-target', '#editAgentModal');
                        fakeBtn.setAttribute('data-agentid', btn.getAttribute('data-agentid'));
                        fakeBtn.setAttribute('data-fullname', btn.getAttribute('data-fullname'));
                        fakeBtn.setAttribute('data-email', btn.getAttribute('data-email'));
                        fakeBtn.setAttribute('data-phone', btn.getAttribute('data-phone'));
                        // fakeBtn.setAttribute('data-address', btn.getAttribute('data-address'));
                        fakeBtn.setAttribute('data-status', btn.getAttribute('data-status'));
                        document.body.appendChild(fakeBtn);
                        fakeBtn.click();
                        fakeBtn.remove();
                    }, 150);
                };
            });
        });
    </script>
}

