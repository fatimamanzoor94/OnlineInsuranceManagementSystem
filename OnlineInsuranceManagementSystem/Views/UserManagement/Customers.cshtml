@model List<OnlineInsuranceManagementSystem.Models.User>
@{
    ViewData["Title"] = "Customers Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 w-100 mb-3" style="border-radius: 30px; background-color: #f5f8fd;">
    <div class="p-3 main-card">
        <div class="container-fluid card-scroll-content px-3">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3 flex-wrap gap-2">
                <h4 class="mb-0">Customers Management</h4>
                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 rounded-pill px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#addCustomerModal">
                    <i class="bx bx-plus"></i> Add Customer
                </button>
            </div>

            <!-- Search & Filter -->
            <div class="card custom-card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Name</label>
                            <input type="text" id="searchName"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter full name..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Search by Email</label>
                            <input type="email" id="searchEmail"
                                   class="form-control form-control-sm rounded-pill px-3"
                                   placeholder="Enter email..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Filter Status</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill active" data-filter="all">All</button>
                                <button class="btn btn-sm btn-outline-success rounded-pill" data-filter="active">Active</button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill" data-filter="inactive">Inactive</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="card custom-card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pb-2 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h4 class="mb-1 fw-semibold">All Customers</h4>
                            <small class="text-muted">Manage your customer accounts</small>
                        </div>
                        <!-- Export Buttons -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                    onclick="exportTable('excel', 'customersTable', 'Customers')">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                    onclick="exportTable('pdf', 'customersTable', 'Customers')">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive p-3">
                        <table class="table align-middle mb-0" id="customersTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Customer ID</th>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model.Where(x => x.Role == "Customer"))
                                {
                                    <tr>
                                        <td>#CUS-@customer.UserId</td>
                                        <td>@customer.FullName</td>
                                        <td>@customer.Email</td>
                                        <td>@customer.Phone</td>
                                        <td>
                                            @if (customer.Status)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>@customer.CreatedAt.ToString("dd-MMM-yyyy")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm d-flex gap-2">
                                                <!-- VIEW BUTTON -->
                                                <button class="btn btn-outline-info view-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#viewCustomerModal"
                                                        data-customerid="@customer.UserId"
                                                        data-fullname="@customer.FullName"
                                                        data-email="@customer.Email"
                                                        data-phone="@customer.Phone"
                                                        data-address="@customer.Address"
                                                        data-status="@customer.Status"
                                                        data-createdat="@customer.CreatedAt.ToString("dd-MMM-yyyy")"
                                                        title="View Details">
                                                    View
                                                </button>

                                                <!-- EDIT BUTTON -->
                                                <button class="btn btn-outline-warning edit-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editCustomerModal"
                                                        data-customerid="@customer.UserId"
                                                        data-fullname="@customer.FullName"
                                                        data-email="@customer.Email"
                                                        data-phone="@customer.Phone"
                                                        data-address="@customer.Address"
                                                        data-status="@customer.Status"
                                                        title="Edit">
                                                    Edit
                                                </button>

                                                <!-- DELETE BUTTON -->
                                                <button type="button"
                                                        class="btn btn-outline-danger delete-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteCustomerModal"
                                                        data-customerid="@customer.UserId"
                                                        data-customername="@customer.FullName"
                                                        title="Delete">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                        <small class="text-muted">Total Users: @Model.Count</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== ADD CUSTOMER MODAL ==================== -->
<div class="modal fade" id="addCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Add New Customer</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="CreateCustomer" method="post">
                    <input type="text" name="FullName" class="form-control mb-2 rounded-pill" placeholder="Full Name" required pattern="[A-Za-z ]{3,100}" title="Only alphabets allowed (3-100 characters)" />
                    <input type="email" name="Email" class="form-control mb-2 rounded-pill" placeholder="Email" required />
                    <input type="password" name="Password" class="form-control mb-2 rounded-pill" placeholder="Password" required minlength="6" title="Password must be at least 6 characters" />
                    <input type="tel" name="Phone" class="form-control mb-2 rounded-pill" placeholder="03XXXXXXXXX" required pattern="03[0-9]{9}" title="Phone format should be 03XXXXXXXXX" />
                    <textarea name="Address" class="form-control mb-2 rounded-3" placeholder="Address"></textarea>
                    <input type="hidden" name="Role" value="Customer" />
                    <select name="Status" class="form-select mb-2 rounded-pill">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Save Customer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== EDIT CUSTOMER MODAL ==================== -->
<div class="modal fade" id="editCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Edit Customer</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="EditCustomer" method="post">
                    <input type="hidden" id="editCustomerId" name="UserId" />
                    <input type="text" id="editFullName" name="FullName" class="form-control mb-2 rounded-pill" placeholder="Full Name" required pattern="[A-Za-z ]{3,100}" title="Only alphabets allowed (3-100 characters)" />
                    <input type="email" id="editEmail" name="Email" class="form-control mb-2 rounded-pill" placeholder="Email" required />
                    <input type="tel" id="editPhone" name="Phone" class="form-control mb-2 rounded-pill" placeholder="03XXXXXXXXX" required pattern="03[0-9]{9}" title="Phone format should be 03XXXXXXXXX" />
                    <textarea id="editAddress" name="Address" class="form-control mb-2 rounded-3" placeholder="Address"></textarea>
                    <select id="editStatus" name="Status" class="form-select mb-2 rounded-pill">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Update Customer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DELETE CUSTOMER MODAL ==================== -->
<div class="modal fade" id="deleteCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal position-relative">
            <div class="delete-icon-wrapper">
                <div class="icon-box">
                    <i class="fas fa-trash-alt"></i>
                </div>
            </div>
            <div class="modal-body text-center pt-5 pb-4">
                <h4 class="fw-bold">Delete Customer?</h4>
                <p class="text-muted">
                    You are about to delete <strong id="deleteCustomerName"></strong><br />
                    This action cannot be undone.
                </p>
                <form asp-action="DeleteCustomer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteCustomerId" name="id" />
                    <div class="d-flex gap-2 justify-content-center mt-3">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4 rounded-pill">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== VIEW CUSTOMER DETAILS MODAL ==================== -->
<div class="modal fade" id="viewCustomerModal" tabindex="-1" aria-labelledby="viewCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bx bx-user text-primary"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="viewCustomerModalLabel">Customer Details</h5>
                        <small class="text-muted" id="viewCustomerIdDisplay">#CUS-XXXX</small>
                    </div>
                </div>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body - Card Style -->
            <div class="modal-body pt-3">
                <div class="card border-0 bg-light-subtle rounded-4">
                    <div class="card-body p-4">
                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-user me-1"></i>Full Name</label>
                            <p class="form-control-plaintext fw-semibold mb-0" id="viewFullName">-</p>
                        </div>
                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-envelope me-1"></i>Email Address</label>
                            <p class="form-control-plaintext mb-0" id="viewEmail">
                                <a href="#" class="text-decoration-none" id="viewEmailLink">-</a>
                            </p>
                        </div>
                        <!-- Phone -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-phone me-1"></i>Phone Number</label>
                            <p class="form-control-plaintext mb-0" id="viewPhone">
                                <a href="#" class="text-decoration-none" id="viewPhoneLink">-</a>
                            </p>
                        </div>
                        <!-- Address -->
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1"><i class="bx bx-map me-1"></i>Address</label>
                            <p class="form-control-plaintext mb-0" id="viewAddress">-</p>
                        </div>
                        <!-- Status & Created Date -->
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-badge-check me-1"></i>Status</label>
                                <span id="viewStatusBadge" class="badge rounded-pill">-</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1"><i class="bx bx-calendar me-1"></i>Created Date</label>
                                <p class="form-control-plaintext fw-medium mb-0" id="viewCreatedAt">-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Close
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="viewEditCustomerBtn">
                    Edit Customer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS STYLES ==================== -->
<style>
    /* Delete Modal Animation */
    .delete-modal {
        border-radius: 22px;
        border: none;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        background: #ffffff;
        overflow: visible;
        animation: popIn 0.3s ease;
    }

    .delete-icon-wrapper {
        position: absolute;
        top: -40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .icon-box {
        width: 85px;
        height: 85px;
        background: #fff5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 6px solid white;
    }

        .icon-box i {
            font-size: 34px;
            color: #ff3b3b;
        }

    @@keyframes popIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* View Modal Enhancements */
    #viewCustomerModal .form-control-plaintext {
        font-size: 1.05rem;
        padding: 0.25rem 0;
        border-bottom: 1px dashed #dee2e6;
        border-radius: 0;
    }

        #viewCustomerModal .form-control-plaintext:hover {
            border-bottom-color: #0d6efd;
            transition: border-color 0.2s ease;
        }

    #viewCustomerModal .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        #viewCustomerModal .card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    @@media (max-width: 576px) {
        #viewCustomerModal .modal-body .card-body {
            padding: 1.25rem !important;
        }

        #viewCustomerModal .form-control-plaintext {
            font-size: 1rem;
        }
    }
</style>

<!-- ==================== JAVASCRIPT ==================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==================== SEARCH FUNCTIONALITY ====================
            const searchName = document.getElementById('searchName');
            const searchEmail = document.getElementById('searchEmail');

            function filterTable() {
                const nameVal = searchName.value.toLowerCase();
                const emailVal = searchEmail.value.toLowerCase();

                document.querySelectorAll("#customersTable tbody tr").forEach(row => {
                    const name = row.cells[1]?.textContent.toLowerCase() || '';
                    const email = row.cells[2]?.textContent.toLowerCase() || '';
                    row.style.display = (name.includes(nameVal) && email.includes(emailVal)) ? "" : "none";
                });
            }

            searchName.addEventListener("input", filterTable);
            searchEmail.addEventListener("input", filterTable);


            // ==================== PAGINATION ====================
            const rowsPerPage = 10;
            const tableRows = document.querySelectorAll("#customersTable tbody tr");
            const pagination = document.getElementById("pagination");
            let currentPage = 1;

            function displayTablePage(page) {
                currentPage = page;
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                tableRows.forEach((row, index) => {
                    row.style.display = (index >= start && index < end) ? "" : "none";
                });
                updatePaginationButtons();
            }

            function updatePaginationButtons() {
                pagination.innerHTML = "";
                const pageCount = Math.ceil(tableRows.length / rowsPerPage);

                // Prev Button
                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link rounded-start-pill" href="#">Prev</a>`;
                prevLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage > 1) displayTablePage(currentPage - 1);
                });
                pagination.appendChild(prevLi);

                // Page Numbers
                for (let i = 1; i <= pageCount; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${currentPage === i ? "active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", function (e) {
                        e.preventDefault();
                        displayTablePage(i);
                    });
                    pagination.appendChild(li);
                }

                // Next Button
                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === pageCount ? "disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link rounded-end-pill" href="#">Next</a>`;
                nextLi.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (currentPage < pageCount) displayTablePage(currentPage + 1);
                });
                pagination.appendChild(nextLi);
            }

            displayTablePage(1);


            // ==================== STATUS FILTER ====================
            document.querySelectorAll("[data-filter]").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    const filter = this.getAttribute('data-filter');
                    const rows = document.querySelectorAll("#customersTable tbody tr");

                    rows.forEach(row => {
                        const statusBadge = row.cells[4]?.querySelector('.badge');
                        const isActive = statusBadge && statusBadge.classList.contains('bg-success-subtle');

                        if (filter === 'all') {
                            row.style.display = '';
                        } else if (filter === 'active' && isActive) {
                            row.style.display = '';
                        } else if (filter === 'inactive' && !isActive) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });


            // ==================== EDIT MODAL - Populate Data ====================
            const editModal = document.getElementById('editCustomerModal');
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('editCustomerId').value = button.getAttribute('data-customerid');
                document.getElementById('editFullName').value = button.getAttribute('data-fullname');
                document.getElementById('editEmail').value = button.getAttribute('data-email');
                document.getElementById('editPhone').value = button.getAttribute('data-phone');
                document.getElementById('editAddress').value = button.getAttribute('data-address');

                const status = button.getAttribute('data-status');
                document.getElementById('editStatus').value = (status && status.toLowerCase() === 'true') ? 'true' : 'false';
            });


            // ==================== DELETE MODAL - Populate Data ====================
            const deleteModal = document.getElementById('deleteCustomerModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('deleteCustomerId').value = button.getAttribute('data-customerid');
                document.getElementById('deleteCustomerName').textContent = button.getAttribute('data-customername');
            });


            // ==================== VIEW MODAL - Populate Data ====================
            const viewModal = document.getElementById('viewCustomerModal');

            viewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                const customerId = button.getAttribute('data-customerid');
                const fullName = button.getAttribute('data-fullname');
                const email = button.getAttribute('data-email');
                const phone = button.getAttribute('data-phone');
                const address = button.getAttribute('data-address') || 'Not provided';
                const statusRaw = button.getAttribute('data-status');
                const status = (statusRaw === 'True' || statusRaw === 'true' || statusRaw === 'True');
                const createdAt = button.getAttribute('data-createdat');

                // Populate fields
                document.getElementById('viewCustomerIdDisplay').textContent = `#CUS-${customerId}`;
                document.getElementById('viewFullName').textContent = fullName || '-';

                // Email with mailto
                const emailLink = document.getElementById('viewEmailLink');
                emailLink.textContent = email || '-';
                emailLink.href = email ? `mailto:${email}` : '#';

                // Phone with tel
                const phoneLink = document.getElementById('viewPhoneLink');
                phoneLink.textContent = phone || '-';
                phoneLink.href = phone ? `tel:${phone.replace(/\s+/g, '')}` : '#';

                // Address
                document.getElementById('viewAddress').textContent = address;

                // Status Badge
                const statusBadge = document.getElementById('viewStatusBadge');
                if (status) {
                    statusBadge.className = 'badge bg-success-subtle text-success rounded-pill';
                    statusBadge.textContent = 'Active';
                } else {
                    statusBadge.className = 'badge bg-danger-subtle text-danger rounded-pill';
                    statusBadge.textContent = 'Inactive';
                }

                // Created Date
                document.getElementById('viewCreatedAt').textContent = createdAt || '-';

                // Edit button in view modal -> open edit modal
                document.getElementById('viewEditCustomerBtn').onclick = function() {
                    const modalInstance = bootstrap.Modal.getInstance(viewModal);
                    modalInstance.hide();

                    setTimeout(() => {
                        // Reuse the same data attributes to trigger edit modal
                        const fakeEditBtn = document.createElement('button');
                        fakeEditBtn.setAttribute('data-bs-toggle', 'modal');
                        fakeEditBtn.setAttribute('data-bs-target', '#editCustomerModal');
                        fakeEditBtn.setAttribute('data-customerid', customerId);
                        fakeEditBtn.setAttribute('data-fullname', fullName);
                        fakeEditBtn.setAttribute('data-email', email);
                        fakeEditBtn.setAttribute('data-phone', phone);
                        fakeEditBtn.setAttribute('data-address', address);
                        fakeEditBtn.setAttribute('data-status', statusRaw);
                        document.body.appendChild(fakeEditBtn);
                        fakeEditBtn.click();
                        fakeEditBtn.remove();
                    }, 150);
                };
            });

        });
    </script>
}

